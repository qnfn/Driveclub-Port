--- /dev/null
+++ b/tests/test_fault_emulation.cpp
@@ -0,0 +1,228 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+// DCport: BB_FAULT_EMULATE (gpu/shadps4/video_core/fault_emulation.cpp, from driveclub-recomp).
+// Each instruction runs twice: on plain memory (the reference) and on a no-access page whose
+// faults the emulation handles from a backing copy, as the GPU page protection does in the game.
+// Results (registers, flags, stored bytes) must match; reads of "GPU-written" bytes and unknown
+// instructions must be declined (the handler then unprotects the page so they still complete).
+// Windows only. Build and run: ninja -C out/gpu fault-emulation-test && out/gpu/fault-emulation-test
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <immintrin.h>
+#include <windows.h>
+#include "video_core/buffer_cache/gpu_byte_map.h"
+#include "video_core/fault_emulation.h"
+
+using namespace VideoCore;
+
+namespace {
+constexpr size_t PageSize = 4096;
+constexpr size_t GpuLo = 0x100, GpuHi = 0x110; // bytes the "GPU wrote"
+uint8_t* guest = nullptr;                      // the protected page
+alignas(64) uint8_t backing[PageSize];         // what the backing view holds
+alignas(64) uint8_t plain[PageSize];           // reference runs
+int emulated = 0, declined = 0, failures = 0;
+
+struct TestAccess final : FaultEmulation::Access {
+    bool IsGpuWritten(VAddr addr, u64 size) override {
+        const VAddr lo = reinterpret_cast<VAddr>(guest) + GpuLo;
+        const VAddr hi = reinterpret_cast<VAddr>(guest) + GpuHi;
+        return addr < hi && lo < addr + size;
+    }
+    bool ReadBacking(VAddr addr, void* out, u64 size) override {
+        std::memcpy(out, backing + (addr - reinterpret_cast<VAddr>(guest)), size);
+        return true;
+    }
+    bool Store(VAddr addr, const void* data, u32 size) override {
+        if (IsGpuWritten(addr, size)) {
+            return false;
+        }
+        std::memcpy(backing + (addr - reinterpret_cast<VAddr>(guest)), data, size);
+        return true;
+    }
+} access;
+
+LONG CALLBACK Handler(EXCEPTION_POINTERS* info) {
+    const auto* record = info->ExceptionRecord;
+    const auto addr = static_cast<VAddr>(record->ExceptionInformation[1]);
+    if (record->ExceptionCode != EXCEPTION_ACCESS_VIOLATION ||
+        addr - reinterpret_cast<VAddr>(guest) >= PageSize) {
+        return EXCEPTION_CONTINUE_SEARCH;
+    }
+    const bool write = record->ExceptionInformation[0] == 1;
+    if (write ? FaultEmulation::EmulateStore(info, addr, access)
+              : FaultEmulation::EmulateLoad(info, addr, access)) {
+        ++emulated;
+        return EXCEPTION_CONTINUE_EXECUTION;
+    }
+    // The usual path: the page gets its data and is unprotected (a readback).
+    ++declined;
+    DWORD old;
+    VirtualProtect(guest, PageSize, PAGE_READWRITE, &old);
+    std::memcpy(guest, backing, PageSize);
+    return EXCEPTION_CONTINUE_EXECUTION;
+}
+
+void Reset() {
+    for (size_t i = 0; i < PageSize; ++i) {
+        backing[i] = static_cast<uint8_t>(i * 37 + (i >> 3));
+    }
+    // A few float values for the arithmetic and compares.
+    const float f[4] = {1.5f, -2.25f, 3.0e10f, 0.125f};
+    std::memcpy(backing + 0x300, f, sizeof(f));
+    const double d[2] = {2.5, -7.75};
+    std::memcpy(backing + 0x340, d, sizeof(d));
+    std::memcpy(plain, backing, PageSize);
+    DWORD old;
+    VirtualProtect(guest, PageSize, PAGE_READWRITE, &old);
+    std::memcpy(guest, backing, PageSize);
+    VirtualProtect(guest, PageSize, PAGE_NOACCESS, &old);
+}
+
+// The page as the guest sees it afterwards (backing, or the guest page once unprotected).
+const uint8_t* After() {
+    MEMORY_BASIC_INFORMATION mbi{};
+    VirtualQuery(guest, &mbi, sizeof(mbi));
+    return mbi.Protect == PAGE_NOACCESS ? backing : guest;
+}
+
+template <typename Run>
+void Check(const char* name, Run run, int want_declined = 0) {
+    Reset();
+    alignas(16) uint8_t ref[64]{}, got[64]{};
+    run(plain, ref);
+    std::memcpy(ref + 32, plain + 0x200, 32); // stores land at 0x200
+    const int before = declined;
+    run(guest, got);
+    std::memcpy(got + 32, After() + 0x200, 32);
+    const int took = declined - before;
+    const bool ok = std::memcmp(ref, got, sizeof(ref)) == 0 && (took != 0) == (want_declined != 0);
+    std::printf("%-34s %s%s\n", name, ok ? "ok" : "FAIL",
+                took ? " (declined: usual path)" : "");
+    failures += !ok;
+}
+
+#define GPR_CASE(name, text)                                                                      \
+    Check(name, [](uint8_t* p, uint8_t* out) {                                                    \
+        uint64_t r = 0x1122334455667788ull, f;                                                    \
+        /* cmp p, p first: the flags start the same in both runs */                              \
+        asm volatile("cmpq %2, %2\n\t" text "\n\tpushfq\n\tpopq %1"                               \
+                     : "+r"(r), "=r"(f) : "r"(p) : "memory", "cc");                               \
+        std::memcpy(out, &r, 8);                                                                  \
+        f &= 0x8D5; /* CF PF AF ZF SF OF */                                                       \
+        std::memcpy(out + 8, &f, 8);                                                              \
+    })
+
+#define XMM_CASE(name, text, ...)                                                                 \
+    Check(name, [](uint8_t* p, uint8_t* out) {                                                    \
+        __m128 x = _mm_setr_ps(4.0f, -1.0f, 0.5f, 9.0f);                                          \
+        __m128 y = _mm_setr_ps(-3.0f, 2.0f, 8.0f, -0.25f);                                        \
+        uint64_t f;                                                                               \
+        asm volatile("cmpq %2, %2\n\t" text "\n\tpushfq\n\tpopq %1"                               \
+                     : "+x"(x), "=r"(f) : "r"(p), "x"(y)                                          \
+                     : "memory", "cc");                                                           \
+        _mm_storeu_ps(reinterpret_cast<float*>(out), x);                                          \
+        f &= 0x8D5;                                                                               \
+        std::memcpy(out + 16, &f, 8);                                                             \
+    } __VA_OPT__(, ) __VA_ARGS__)
+
+// The byte map: marks cover whole 16-byte blocks, clears only fully covered ones.
+void CheckByteMap() {
+    VideoCore::GpuByteMap map;
+    const VAddr base = 0x4000001000ull;
+    map.Mark(base + 0x104, 8); // block 0x100..0x10f
+    const bool ok = map.Any(base + 0x100, 1) && map.Any(base + 0x10f, 1) &&
+                    !map.Any(base + 0xf0, 16) && !map.Any(base + 0x110, 16) &&
+                    [&] { map.Clear(base + 0x104, 8); return map.Any(base + 0x100, 16); }() &&
+                    [&] { map.Clear(base + 0x100, 16); return !map.Any(base + 0x100, 16); }() &&
+                    [&] {
+                        map.Mark(base + 0x3ffff8, 16); // across a 4 MiB region boundary
+                        return map.Any(base + 0x3ffff0, 1) && map.Any(base + 0x400000, 1) &&
+                               !map.Any(base + 0x400010, 16);
+                    }();
+    std::printf("%-34s %s\n", "GPU byte map", ok ? "ok" : "FAIL");
+    failures += !ok;
+}
+} // namespace
+
+int main() {
+    _putenv("BB_READBACKS=2");
+    CheckByteMap();
+    if (!FaultEmulation::Enabled()) {
+        std::printf("fault emulation is off\n");
+        return 1;
+    }
+    guest = static_cast<uint8_t*>(VirtualAlloc(nullptr, PageSize, MEM_COMMIT | MEM_RESERVE,
+                                               PAGE_READWRITE));
+    AddVectoredExceptionHandler(1, Handler);
+
+    // Loads into general registers (operand 0 = r, operand 2 = the page).
+    GPR_CASE("mov r64, m64", "movq 0x208(%2), %0");
+    GPR_CASE("mov r32, m32 (zero-extends)", "movl 0x20c(%2), %k0");
+    GPR_CASE("mov r16, m16 (keeps the rest)", "movw 0x20e(%2), %w0");
+    GPR_CASE("mov r8, m8 (keeps the rest)", "movb 0x211(%2), %b0");
+    GPR_CASE("movzx r32, m8", "movzbl 0x213(%2), %k0");
+    GPR_CASE("movsx r64, m16", "movswq 0x214(%2), %0");
+    GPR_CASE("movsxd r64, m32", "movslq 0x2fc(%2), %0");
+    // Compares and integer arithmetic (flags too).
+    GPR_CASE("cmp m32, imm", "cmpl $0x7f, 0x220(%2)");
+    GPR_CASE("cmp r64, m64", "cmpq 0x228(%2), %0");
+    GPR_CASE("test m8, imm", "testb $0x81, 0x231(%2)");
+    GPR_CASE("add r64, m64", "addq 0x238(%2), %0");
+    GPR_CASE("sub r32, m32", "subl 0x240(%2), %k0");
+    GPR_CASE("xor r16, m16", "xorw 0x244(%2), %w0");
+    GPR_CASE("and r8, m8", "andb 0x246(%2), %b0");
+    // SSE / AVX-128 loads, arithmetic, compares and lane operations (operand 0 = x, 3 = y).
+    XMM_CASE("movss xmm, m32", "movss 0x300(%2), %0");
+    XMM_CASE("movsd xmm, m64", "movsd 0x340(%2), %0");
+    XMM_CASE("movups xmm, m128", "movups 0x301(%2), %0");
+    XMM_CASE("vmovss xmm, m32 (VEX)", "vmovss 0x304(%2), %0");
+    XMM_CASE("vmovups xmm, m128 (VEX)", "vmovups 0x300(%2), %0");
+    XMM_CASE("addss xmm, m32", "addss 0x300(%2), %0");
+    XMM_CASE("mulps xmm, m128", "mulps 0x300(%2), %0");
+    XMM_CASE("vsubss xmm, xmm, m32 (VEX)", "vsubss 0x308(%2), %3, %0");
+    XMM_CASE("vmaxps xmm, xmm, m128 (VEX)", "vmaxps 0x300(%2), %3, %0");
+    XMM_CASE("divsd xmm, m64", "divsd 0x348(%2), %0");
+    XMM_CASE("ucomiss xmm, m32", "ucomiss 0x304(%2), %0");
+    XMM_CASE("vcomiss xmm, m32 (VEX)", "vcomiss 0x30c(%2), %0");
+    XMM_CASE("blendps xmm, m128, imm", "blendps $0x5, 0x300(%2), %0");
+    XMM_CASE("vblendps xmm, xmm, m128, imm", "vblendps $0xa, 0x300(%2), %3, %0");
+    XMM_CASE("shufps xmm, m128, imm", "shufps $0x1b, 0x300(%2), %0");
+    XMM_CASE("insertps xmm, m32, imm", "insertps $0x29, 0x308(%2), %0");
+    XMM_CASE("andps xmm, m128", "andps 0x300(%2), %0");
+    XMM_CASE("vpxor xmm, xmm, m128 (VEX)", "vpxor 0x300(%2), %3, %0");
+    XMM_CASE("andnps xmm, m128", "andnps 0x300(%2), %0");
+    // Stores (compared through the page afterwards).
+    GPR_CASE("mov m64, r64", "movq %0, 0x200(%2)");
+    GPR_CASE("mov m16, r16", "movw %w0, 0x20a(%2)");
+    GPR_CASE("mov m32, imm", "movl $0x12345678, 0x210(%2)");
+    GPR_CASE("mov m8, imm", "movb $0x9a, 0x21f(%2)");
+    XMM_CASE("movups m128, xmm", "movups %0, 0x200(%2)");
+    XMM_CASE("movss m32, xmm", "movss %0, 0x214(%2)");
+    XMM_CASE("vmovsd m64, xmm (VEX)", "vmovsd %0, 0x208(%2)");
+    XMM_CASE("extractps m32, xmm, imm", "extractps $2, %0, 0x21c(%2)");
+    // Declined: bytes the GPU wrote, and instructions the emulation does not handle.
+    Check("mov r64, m64 on GPU-written bytes", [](uint8_t* p, uint8_t* out) {
+        uint64_t r;
+        asm volatile("movq 0x108(%1), %0" : "=r"(r) : "r"(p) : "memory");
+        std::memcpy(out, &r, 8);
+    }, 1);
+    Check("mov m32 over GPU-written bytes", [](uint8_t* p, uint8_t*) {
+        asm volatile("movl $1, 0x10c(%0)" : : "r"(p) : "memory");
+    }, 1);
+    Check("lock xadd m32, r32", [](uint8_t* p, uint8_t* out) {
+        uint32_t r = 3;
+        asm volatile("lock xaddl %0, 0x230(%1)" : "+r"(r) : "r"(p) : "memory");
+        std::memcpy(out, &r, 4);
+    }, 1);
+    Check("rep stosb", [](uint8_t* p, uint8_t*) {
+        void* dst = p + 0x200;
+        size_t n = 24;
+        asm volatile("rep stosb" : "+D"(dst), "+c"(n) : "a"(0x5a) : "memory");
+    }, 1);
+
+    std::printf("emulated %d, declined %d\n", emulated, declined);
+    std::printf("Fault emulation: %s\n", failures ? "FAILED" : "PASS");
+    return failures ? 1 : 0;
+}

-            attachment.image_layout = target.layout;
-        }
-        image.usage.depth_target = true;
-        if (upscaler->Enabled()) {
-            VulkanUpscalerTarget depth_redirect;
-            depth_redirected = upscaler->RedirectDepth(image_id, depth_redirect);

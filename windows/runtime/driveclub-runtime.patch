+            fprintf(stderr,"    entry %u: %08x %08x %08x %08x %08x %08x %08x %08x (category %g)\n",
+                    i,w[0],w[1],w[2],w[3],w[4],w[5],w[6],w[7],e[3]);
+            ++shown;

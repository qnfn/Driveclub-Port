+                         [](const auto& a, const auto& b) { return a.second < b.second; });
+    }
+    u64 dropped = 0;
+    for (const auto& [addr, size] : merged) {
+        if (total + size > AsyncReadbackMaxFrameBytes) {
+            ++dropped;
+            continue;
+        }
+        readbacks.push_back({addr, size, total});
+        total += Common::AlignUp(size, 64);
+        BbStats::async_ranges[size <= 256 ? 0 : size <= 4_KB ? 1 : size <= 64_KB ? 2 : 3]

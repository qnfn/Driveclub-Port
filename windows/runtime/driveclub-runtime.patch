+
+/// A thick line from (x0, y0) to (x1, y1) with round ends.
+void Segment(DcCanvas& c, float x0, float y0, float x1, float y1, float width, Color color) {
+    Fill(c, 0, float(c.h), color, color, [=](float px, float py) {
+        const float dx = x1 - x0, dy = y1 - y0, len2 = dx * dx + dy * dy;
+        const float t = len2 > 0 ? std::clamp(((px - x0) * dx + (py - y0) * dy) / len2, 0.0f, 1.0f) : 0;
+        const float qx = x0 + t * dx - px, qy = y0 + t * dy - py;
+        return qx * qx + qy * qy <= width * width / 4;
+    });
+}
+
+void Ring(DcCanvas& c, float cx, float cy, float r, float width, Color color) {
+    Fill(c, 0, float(c.h), color, color, [=](float px, float py) {
+        const float d = std::sqrt((px - cx) * (px - cx) + (py - cy) * (py - cy));
+        return std::abs(d - r) <= width / 2;
+    });
+}

diff --git a/gpu/shadps4/video_core/renderer_vulkan/vk_breadcrumbs.cpp b/gpu/shadps4/video_core/renderer_vulkan/vk_breadcrumbs.cpp
new file mode 100644
index 0000000..b4946df
--- /dev/null
+++ b/gpu/shadps4/video_core/renderer_vulkan/vk_breadcrumbs.cpp
@@ -0,0 +1,380 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "video_core/renderer_vulkan/vk_breadcrumbs.h"
+
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <functional>
+#include <map>
+#include <mutex>
+#include <string>
+#include <vector>
+#include <vk_mem_alloc.h>
+#include "video_core/renderer_vulkan/vk_instance.h"
+
+namespace Vulkan::Breadcrumbs {
+namespace {
+
+// Per site: [0] last started, [1] last finished (sequence numbers, 0 = never).
+volatile u32* slots = nullptr;
+vk::Buffer buffer{};
+std::array<std::atomic<u32>, SiteCount> sequence{};
+std::atomic<bool> reported{false};
+// DCport: VK_EXT_device_fault, for the faulting address after a loss.
+VkDevice fault_device = VK_NULL_HANDLE;
+PFN_vkGetDeviceFaultInfoEXT get_fault_info = nullptr;
+
+const char* FaultKind(VkDeviceFaultAddressTypeEXT type) {
+    switch (type) {
+    case VK_DEVICE_FAULT_ADDRESS_TYPE_NONE_EXT: return "none";
+    case VK_DEVICE_FAULT_ADDRESS_TYPE_READ_INVALID_EXT: return "invalid read";
+    case VK_DEVICE_FAULT_ADDRESS_TYPE_WRITE_INVALID_EXT: return "invalid write";
+    case VK_DEVICE_FAULT_ADDRESS_TYPE_EXECUTE_INVALID_EXT: return "invalid execute";
+    case VK_DEVICE_FAULT_ADDRESS_TYPE_INSTRUCTION_POINTER_UNKNOWN_EXT: return "shader at (unknown)";
+    case VK_DEVICE_FAULT_ADDRESS_TYPE_INSTRUCTION_POINTER_INVALID_EXT: return "shader at (invalid)";
+    case VK_DEVICE_FAULT_ADDRESS_TYPE_INSTRUCTION_POINTER_FAULT_EXT: return "shader at (fault)";
+    default: return "other";
+    }
+}
+
+namespace AddressLog {
+void Describe(u64 address, u64 precision);
+} // namespace AddressLog
+
+void ReportFault() {
+    if (!get_fault_info) {
+        return;
+    }
+    VkDeviceFaultCountsEXT counts{.sType = VK_STRUCTURE_TYPE_DEVICE_FAULT_COUNTS_EXT};
+    if (get_fault_info(fault_device, &counts, nullptr) != VK_SUCCESS) {
+        std::printf("GPU fault: the driver gave no details\n");
+        return;
+    }
+    std::vector<VkDeviceFaultAddressInfoEXT> addresses(counts.addressInfoCount);
+    std::vector<VkDeviceFaultVendorInfoEXT> vendor(counts.vendorInfoCount);
+    counts.vendorBinarySize = 0;
+    VkDeviceFaultInfoEXT info{.sType = VK_STRUCTURE_TYPE_DEVICE_FAULT_INFO_EXT,
+                              .pAddressInfos = addresses.empty() ? nullptr : addresses.data(),
+                              .pVendorInfos = vendor.empty() ? nullptr : vendor.data()};
+    const VkResult result = get_fault_info(fault_device, &counts, &info);
+    if (result != VK_SUCCESS && result != VK_INCOMPLETE) {
+        std::printf("GPU fault: the driver gave no details (%d)\n", int(result));
+        return;
+    }
+    std::printf("GPU fault: %s\n", info.description[0] ? info.description : "(no description)");
+    for (u32 i = 0; i < counts.addressInfoCount; ++i) {
+        const auto& a = addresses[i];
+        std::printf("  %s at GPU address %#llx (+/- %#llx)\n", FaultKind(a.addressType),
+                    (unsigned long long)a.reportedAddress,
+                    (unsigned long long)a.addressPrecision);
+        AddressLog::Describe(a.reportedAddress, a.addressPrecision);
+    }
+    for (u32 i = 0; i < counts.vendorInfoCount; ++i) {
+        std::printf("  vendor: %s (code %#llx, data %#llx)\n", vendor[i].description,
+                    (unsigned long long)vendor[i].vendorFaultCode,
+                    (unsigned long long)vendor[i].vendorFaultData);
+    }
+}
+
+// DCport: GPU address log (VK_EXT_device_address_binding_report). The driver reports every
+// address range it binds or frees; a device fault is then traced to what lived there, or to what
+// was freed there and when. Freed ranges are all kept (by base address, newest per base), so an
+// old free still counts; labels name ranges the driver does not report (sparse arenas).
+namespace AddressLog {
+
+struct Range {
+    u64 size{};
+    u64 handle{};
+    vk::ObjectType type{};
+    bool internal{};
+    u32 bound_ms{};
+    u32 freed_ms{};
+    u64 serial{};
+};
+
+struct Label {
+    u64 size{};
+    std::string text;
+};
+
+std::mutex mutex;
+std::map<u64, Range> live;
+std::map<u64, Range> freed;
+std::map<u64, Label> labels;
+std::function<std::string(u64)> describer;
+u64 events = 0;
+bool enabled = false;
+vk::UniqueDebugUtilsMessengerEXT messenger;
+const auto start_time = std::chrono::steady_clock::now();
+
+u32 NowMs() {
+    return u32(std::chrono::duration_cast<std::chrono::milliseconds>(
+                   std::chrono::steady_clock::now() - start_time)
+                   .count());
+}
+
+VKAPI_ATTR VkBool32 VKAPI_CALL OnBinding(vk::DebugUtilsMessageSeverityFlagBitsEXT,
+                                         vk::DebugUtilsMessageTypeFlagsEXT,
+                                         const vk::DebugUtilsMessengerCallbackDataEXT* data,
+                                         void*) {
+    const auto* binding = static_cast<const vk::DeviceAddressBindingCallbackDataEXT*>(nullptr);
+    for (auto* next = static_cast<const vk::BaseInStructure*>(data->pNext); next;
+         next = next->pNext) {
+        if (next->sType == vk::StructureType::eDeviceAddressBindingCallbackDataEXT) {
+            binding = reinterpret_cast<const vk::DeviceAddressBindingCallbackDataEXT*>(next);
+            break;
+        }
+    }
+    if (!binding || binding->size == 0) {
+        return VK_FALSE;
+    }
+    Range range{
+        .size = binding->size,
+        .internal = bool(binding->flags & vk::DeviceAddressBindingFlagBitsEXT::eInternalObject),
+    };
+    if (data->objectCount > 0 && data->pObjects) {
+        range.handle = data->pObjects[0].objectHandle;
+        range.type = data->pObjects[0].objectType;
+    }
+    const u64 base = binding->baseAddress;
+    std::scoped_lock lk{mutex};
+    range.serial = ++events;
+    if (binding->bindingType == vk::DeviceAddressBindingTypeEXT::eBind) {
+        range.bound_ms = NowMs();
+        live[base] = range;
+        return VK_FALSE;
+    }
+    const auto it = live.find(base);
+    if (it != live.end()) {
+        range.bound_ms = it->second.bound_ms;
+        if (!range.handle) {
+            range.handle = it->second.handle;
+            range.type = it->second.type;
+        }
+        live.erase(it);
+    }
+    range.freed_ms = NowMs();
+    freed[base] = range;
+    return VK_FALSE;
+}
+
+const char* TypeName(vk::ObjectType type) {
+    switch (type) {
+    case vk::ObjectType::eBuffer: return "buffer";
+    case vk::ObjectType::eImage: return "image";
+    case vk::ObjectType::eDeviceMemory: return "memory";
+    case vk::ObjectType::eAccelerationStructureKHR: return "acceleration structure";
+    default: return "object";
+    }
+}
+
+void PrintRange(const char* what, u64 base, const Range& r, u64 address) {
+    std::printf("    %s: %s %#llx..%#llx (%llu KiB)%s, handle %#llx, %+lld bytes in, bound at "
+                "%u ms (#%llu)",
+                what, TypeName(r.type), (unsigned long long)base,
+                (unsigned long long)(base + r.size), (unsigned long long)(r.size >> 10),
+                r.internal ? " [driver internal]" : "", (unsigned long long)r.handle,
+                (long long)(address - base), r.bound_ms, (unsigned long long)r.serial);
+    if (r.freed_ms) {
+        std::printf(", freed at %u ms (%u ms before the fault)", r.freed_ms,
+                    NowMs() - r.freed_ms);
+    }
+    std::printf("\n");
+}
+
+/// Everything known about a faulting address, `precision` bytes either side.
+void Describe(u64 address, u64 precision) {
+    if (!enabled && labels.empty() && !describer) {
+        return;
+    }
+    std::scoped_lock lk{mutex};
+    const auto contains = [&](u64 base, u64 size) {
+        return address + precision >= base && address - std::min(address, precision) < base + size;
+    };
+    if (enabled) {
+        bool found = false;
+        auto it = live.upper_bound(address + precision);
+        for (int i = 0; i < 64 && it != live.begin(); ++i) {
+            --it;
+            if (contains(it->first, it->second.size)) {
+                PrintRange("inside live", it->first, it->second, address);
+                found = true;
+            }
+        }
+        if (!found) {
+            std::printf("    no live buffer or image holds it\n");
+            auto above = live.upper_bound(address);
+            if (above != live.begin()) {
+                const auto below = std::prev(above);
+                PrintRange("nearest below", below->first, below->second, address);
+            }
+            if (above != live.end()) {
+                PrintRange("nearest above", above->first, above->second, address);
+            }
+        }
+        // Freed ranges that held it, newest first (several objects can have used the address).
+        std::vector<std::pair<u64, const Range*>> holders;
+        auto f = freed.upper_bound(address + precision);
+        for (int i = 0; i < 4096 && f != freed.begin(); ++i) {
+            --f;
+            if (contains(f->first, f->second.size)) {
+                holders.emplace_back(f->first, &f->second);
+            }
+        }
+        std::sort(holders.begin(), holders.end(),
+                  [](const auto& a, const auto& b) { return a.second->serial > b.second->serial; });
+        if (holders.empty()) {
+            std::printf("    never freed (%zu freed ranges known)\n", freed.size());
+        }
+        for (size_t i = 0; i < holders.size() && i < 4; ++i) {
+            PrintRange("freed", holders[i].first, *holders[i].second, address);
+        }
+        std::printf("    %zu live GPU address ranges, %llu binds/unbinds so far\n", live.size(),
+                    (unsigned long long)events);
+    }
+    for (const auto& [base, label] : labels) {
+        if (contains(base, label.size)) {
+            std::printf("    in %s (%#llx..%#llx, %+lld bytes in)\n", label.text.c_str(),
+                        (unsigned long long)base, (unsigned long long)(base + label.size),
+                        (long long)(address - base));
+        }
+    }
+    if (describer) {
+        const std::string text = describer(address);
+        if (!text.empty()) {
+            std::printf("    %s\n", text.c_str());
+        }
+    }
+}
+
+} // namespace AddressLog
+
+const char* SiteName(u32 site) {
+    switch (site) {
+    case Submit0 + 0: return "submission (scheduler 0)";
+    case Submit0 + 1: return "submission (scheduler 1)";
+    case Submit0 + 2: return "submission (scheduler 2)";
+    case Submit0 + 3: return "submission (scheduler 3)";
+    case DcUpscale: return "Driveclub upscaler (motion + FSR + merge)";
+    case FrameGen: return "frame generation";
+    case Present: return "present blit";
+    case HudlessCopy: return "HUD-less copy";
+    default: return "other";
+    }
+}
+
+} // namespace
+
+void Init(const Instance& instance) {
+    if (instance.IsDeviceFaultSupported() && !get_fault_info) {
+        fault_device = instance.GetDevice();
+        get_fault_info = reinterpret_cast<PFN_vkGetDeviceFaultInfoEXT>(
+            instance.GetDevice().getProcAddr("vkGetDeviceFaultInfoEXT"));
+        if (get_fault_info) {
+            std::printf("GPU faults: on (VK_EXT_device_fault); a device loss names the address\n");
+        }
+    }
+    if (instance.IsAddressBindingReportSupported() && !AddressLog::messenger) {
+        const vk::DebugUtilsMessengerCreateInfoEXT messenger_ci = {
+            .messageSeverity = vk::DebugUtilsMessageSeverityFlagBitsEXT::eInfo |
+                               vk::DebugUtilsMessageSeverityFlagBitsEXT::eVerbose |
+                               vk::DebugUtilsMessageSeverityFlagBitsEXT::eWarning |
+                               vk::DebugUtilsMessageSeverityFlagBitsEXT::eError,
+            .messageType = vk::DebugUtilsMessageTypeFlagBitsEXT::eDeviceAddressBinding,
+            .pfnUserCallback = AddressLog::OnBinding,
+        };
+        auto [result, messenger] =
+            instance.GetInstance().createDebugUtilsMessengerEXTUnique(messenger_ci);
+        if (result == vk::Result::eSuccess) {
+            AddressLog::messenger = std::move(messenger);
+            AddressLog::enabled = true;
+            std::printf("GPU address log: on; a GPU fault names the buffer or image there, live "
+                        "or freed\n");
+        }
+    }
+    const char* env = std::getenv("BB_GPU_MARKERS");
+    if ((env && env[0] == '0') || !instance.IsAmdBufferMarkerSupported() || slots) {
+        return;
+    }
+    const VkBufferCreateInfo buffer_ci{
+        .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO,
+        .size = SiteCount * 2 * sizeof(u32),
+        .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+    };
+    // Host memory: still readable after the device is gone.
+    const VmaAllocationCreateInfo alloc_ci{
+        .flags = VMA_ALLOCATION_CREATE_MAPPED_BIT |
+                 VMA_ALLOCATION_CREATE_HOST_ACCESS_RANDOM_BIT,
+        .usage = VMA_MEMORY_USAGE_AUTO_PREFER_HOST,
+        .requiredFlags = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT,
+    };
+    VkBuffer raw{};
+    VmaAllocation allocation{};
+    VmaAllocationInfo info{};
+    if (vmaCreateBuffer(instance.GetAllocator(), &buffer_ci, &alloc_ci, &raw, &allocation,
+                        &info) != VK_SUCCESS ||
+        !info.pMappedData) {
+        std::printf("GPU markers: no host buffer, off\n");
+        return;
+    }
+    buffer = raw;
+    slots = static_cast<volatile u32*>(info.pMappedData);
+    for (u32 i = 0; i < SiteCount * 2; ++i) {
+        slots[i] = 0;
+    }
+    std::printf("GPU markers: on (VK_AMD_buffer_marker); a device loss reports where the GPU was\n");
+}
+
+void Begin(vk::CommandBuffer cmdbuf, u32 site) {
+    if (!slots || site >= SiteCount) {
+        return;
+    }
+    const u32 seq = sequence[site].fetch_add(1, std::memory_order_relaxed) + 1;
+    cmdbuf.writeBufferMarkerAMD(vk::PipelineStageFlagBits::eTopOfPipe, buffer,
+                                site * 2 * sizeof(u32), seq);
+}
+
+void End(vk::CommandBuffer cmdbuf, u32 site) {
+    if (!slots || site >= SiteCount) {
+        return;
+    }
+    // The sequence Begin used: the same thread records both for a site.
+    const u32 seq = sequence[site].load(std::memory_order_relaxed);
+    cmdbuf.writeBufferMarkerAMD(vk::PipelineStageFlagBits::eBottomOfPipe, buffer,
+                                (site * 2 + 1) * sizeof(u32), seq);
+}
+
+void Report() {
+    if (reported.exchange(true)) {
+        return;
+    }
+    if (slots) {
+        std::printf("GPU markers at the device loss (started / finished / recorded):\n");
+        for (u32 site = 0; site < SiteCount; ++site) {
+            const u32 recorded = sequence[site].load();
+            if (!recorded) {
+                continue;
+            }
+            const u32 started = slots[site * 2], finished = slots[site * 2 + 1];
+            std::printf("  %-42s %u / %u / %u%s\n", SiteName(site), started, finished,
+                        recorded, started != finished ? "  <- running on the GPU" : "");
+        }
+    }
+    ReportFault();
+    std::fflush(stdout);
+}
+
+void NoteRange(u64 gpu_address, u64 size, std::string label) {
+    std::scoped_lock lk{AddressLog::mutex};
+    AddressLog::labels[gpu_address] = {size, std::move(label)};
+}
+

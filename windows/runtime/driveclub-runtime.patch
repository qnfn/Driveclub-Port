+u64 BufferCache::CollectDownloads(const Buffer* arena, VAddr device_addr, u64 size,
+                                  DownloadCopies& copies) {
+    u64 total_size_bytes = 0;
+    const VAddr arena_base = arena->cpu_addr;
+    memory_tracker->ForEachDownloadRange<false>(device_addr, size, [&](u64 address, u64 size) {
+        const auto add_download = [&](VAddr start, VAddr end) {
+            copies.push_back(vk::BufferCopy{
+                .srcOffset = start - arena_base,
+                .dstOffset = total_size_bytes,
+                .size = end - start,
+            });
+            // Align up to avoid cache conflicts
+            total_size_bytes += Common::AlignUp(end - start, 64);
+        };
+        std::scoped_lock ranges_lk{gpu_ranges_mutex};
+        gpu_modified_ranges.ForEachInRange(address, size, add_download);
+        gpu_modified_ranges.Subtract(address, size);
+    });
+    return total_size_bytes;
+}
+
+bool BufferCache::ReadbackResolved(VAddr device_addr, u64 size, bool is_write) {
+    if (!is_write) {
+        return !memory_tracker->IsRegionGpuModified(device_addr, size);
+    }
+    // Marks the range CPU modified if it is GPU clean.
+    bool resolved = true;
+    memory_tracker->InvalidateRegion(device_addr, size, [&resolved] { resolved = false; });
+    return resolved;
+}
+
+bool BufferCache::OffloadReadback(VAddr device_addr, u64 size, bool is_write) {
+    const VAddr window = Common::AlignDown(device_addr, ReadbackWindowSize);
+    if (device_addr + size > window + ReadbackWindowSize) {
+        return false;
+    }
+    if (readback_fastpath && !is_write && ReleaseSharedRead(device_addr, size)) {
+        return true;
+    }
+    // A request still GPU modified after two rounds of its own takes the synchronous download,
+    // which copies and unmarks in one GPU thread command.
+    for (u32 attempts = 0; attempts < 2;) {
+        if (WaitPendingReadback(window, device_addr, size, is_write)) {
+            return true;
+        }
+        static const bool trace = std::getenv("BB_READBACK_TRACE") != nullptr;
+        using Clock = std::chrono::steady_clock;
+        const auto start = Clock::now();
+        Readback job{.window = window, .request = device_addr, .request_size = size};
+        liverpool->SendCommand<true>([this, &job] { RecordReadback(job); });
+        const auto recorded = Clock::now();
+        if (job.busy) {
+            std::unique_lock lk{readback_mutex};
+            readback_cv.wait(lk, [&] { return !IsReadbackPending(window, ReadbackWindowSize); });
+        } else {
+            ++attempts;
+            if (!job.copies.empty()) {
+                scheduler.GetWorkSemaphore()->Wait(job.tick);
+                FinishReadback(job);
+            }
+        }
+        if (trace) {
+            const auto done = Clock::now();
+            const double command_ms =
+                std::chrono::duration<double, std::milli>(recorded - start).count();
+            const double total_ms = std::chrono::duration<double, std::milli>(done - start).count();
+            auto& st = readback_stats;
+            std::scoped_lock lk{st.mutex};
+            ++st.jobs;
+            st.hits += job.hits_gpu_bytes;
+            st.empty += !job.busy && job.copies.empty();
+            st.busy += job.busy;
+            st.command_ms += command_ms;
+            st.copy_ms += total_ms - command_ms;
+            st.worst_ms = std::max(st.worst_ms, total_ms);
+            if (st.jobs % 1000 == 0) {
+                const double secs =
+                    std::chrono::duration<double>(done - st.since).count();
+                std::printf("Offloaded readbacks: %llu (%.0f/s), touching GPU-written bytes %llu, "
+                            "nothing to copy %llu, window busy %llu; wait per readback: GPU "
+                            "thread %.2f ms + copy %.2f ms, worst %.1f ms; reads released "
+                            "without a copy %llu\n",
+                            static_cast<unsigned long long>(st.jobs), 1000.0 / secs,
+                            static_cast<unsigned long long>(st.hits),
+                            static_cast<unsigned long long>(st.empty),
+                            static_cast<unsigned long long>(st.busy), st.command_ms / st.jobs,
+                            st.copy_ms / st.jobs, st.worst_ms,
+                            static_cast<unsigned long long>(released_reads.load()));
+                std::fflush(stdout);
+                st.since = done;
+            }
+        }
+        if (ReadbackResolved(device_addr, size, is_write)) {
+            return true;
+        }
+    }
+    return false;
+}

diff --git a/tests/test_prompt_icons.cpp b/tests/test_prompt_icons.cpp
index a5edf37..37e4026 100644
--- a/tests/test_prompt_icons.cpp
+++ b/tests/test_prompt_icons.cpp
@@ -157,8 +157,56 @@ int main(int argc, char** argv) {
         assert(alpha(area.w / 2, area.h / 2) > 200);
     }
 
-    // PSNR above ~30 dB: differences no one sees at 32x32 in a menu.
-    assert(worst < 65.0);
+    // DCport: DriveClub's icons in each look DCport draws, at each texture's size, encoded into a
+    // copy of the game's bytes with the padding blocks left as they were.
+    static const char* const dc_names[DcCount] = {"cross_A", "circle_B", "square_X", "triangle_Y", "L1_LB",
+                                                  "R1_RB", "L2_LT", "R2_RT", "L3_LS", "R3_RS",
+                                                  "touchpad_back", "touchpad_back_small"};
+    assert(DcBytes(DcCross) == 4096 && DcBytes(DcL1) == 6144 && DcBytes(DcTouchpad) == 4096 &&
+           DcBytes(DcTouchpadSmall) == 2048);
+    static const char* const style_names[DcStyleCount] = {"x360", "xone", "ps5"};
+    double dc_worst = 0;
+    for (int style = 0; style < DcStyleCount; ++style)
+    for (int i = 0; i < DcCount; ++i) {
+        const auto icon = DcIcon(i);
+        const auto& t = DcTextures[i];
+        const auto rgba = DrawDc(icon, DcStyle(style));
+        assert(rgba.size() == size_t(t.width) * t.height * 4);
+        const std::vector<uint8_t> original(DcBytes(icon), 0xab);
+        const auto encoded = EncodeDc(icon, rgba, original);
+        assert(encoded.size() == original.size() && EncodeDc(icon, rgba, original) == encoded);
+        const int pitch = (t.width + 31) / 32 * 32;
+        std::vector<bool> used(encoded.size() / 16);
+        double sum = 0;
+        for (int by = 0; by < t.height / 4; ++by) {
+            for (int bx = 0; bx < t.width / 4; ++bx) {
+                const size_t at = TiledBlockOffset(bx, by, pitch);
+                used[at / 16] = true;
+                int px[16][4];
+                DecodeBlock(&encoded[at], px);
+                for (int p = 0; p < 16; ++p) {
+                    const uint8_t* d = &rgba[((by * 4 + p / 4) * t.width + bx * 4 + p % 4) * 4];
+                    for (int k = 0; k < 3; ++k) sum += std::pow((px[p][k] - d[k]) * d[3] / 255.0, 2);
+                    sum += std::pow(px[p][3] - d[3], 2);
+                }
+            }
+        }
+        for (size_t b = 0; b < used.size(); ++b) {
+            if (!used[b]) assert(encoded[b * 16] == 0xab && encoded[b * 16 + 15] == 0xab);  // padding kept
+        }
+        const double error = sum / (double(t.width) * t.height * 4);
+        dc_worst = std::max(dc_worst, error);
+        std::printf("dc_%s_%-20s %dx%d mse %6.1f\n", style_names[style], dc_names[i], t.width, t.height, error);
+        if (argc > 1) {
+            std::ofstream(std::string(argv[1]) + "/dc_" + style_names[style] + "_" + dc_names[i] + "_" +
+                              std::to_string(t.width) + "x" + std::to_string(t.height) + ".rgba",
+                          std::ios::binary)
+                .write(reinterpret_cast<const char*>(rgba.data()), rgba.size());
+        }
+    }
+
+    // PSNR above ~30 dB: differences no one sees at 32x32 in a menu (the DriveClub icons too).
+    assert(worst < 65.0 && dc_worst < 65.0);
     std::printf("prompt icons: all tests passed (worst mse %.1f)\n", worst);
     return 0;
 }
diff --git a/tests/test_trophy.c b/tests/test_trophy.c
new file mode 100644
index 0000000..b66b116
--- /dev/null
+++ b/tests/test_trophy.c
@@ -0,0 +1,94 @@
+/* DCport: earned trophies survive a restart (runtime_trophy.c). */
+#include "runtime.h"
+#include <assert.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#ifdef _WIN32
+#include <direct.h>
+#define REMOVE_DIR(path) _rmdir(path)
+#define SET_ENV(name, value) _putenv_s(name, value)
+#else
+#include <unistd.h>
+#define REMOVE_DIR(path) rmdir(path)
+#define SET_ENV(name, value) setenv(name, value, 1)
+#endif
+
+static char user_dir[512];
+const char *runtime_file_user_dir(void) { return user_dir; }
+
+static void path(char *out, size_t size, const char *name) { snprintf(out, size, "%s/%s", user_dir, name); }
+static void clean(void) {
+    char p[600];
+    const char *files[] = {"trophies/1.txt", "trophies/1.txt.new", "trophies/2.txt", "trophies.log"};
+    for (unsigned i = 0; i < sizeof files / sizeof *files; ++i) { path(p, sizeof p, files[i]); remove(p); }
+    path(p, sizeof p, "trophies"); REMOVE_DIR(p);
+    REMOVE_DIR(user_dir);
+}
+static void write_file(const char *name, const char *text) {
+    char p[600]; path(p, sizeof p, name);
+    FILE *f = fopen(p, "wb"); assert(f); fputs(text, f); fclose(f);
+}
+static int exists(const char *name) {
+    char p[600]; path(p, sizeof p, name);
+    FILE *f = fopen(p, "rb"); if (f) fclose(f);
+    return f != NULL;
+}
+
+int main(void) {
+    const char *temp = getenv("TEMP");
+    snprintf(user_dir, sizeof user_dir, "%s/dcport-trophy-test", temp && *temp ? temp : "/tmp");
+    clean();
+#ifdef _WIN32
+    _mkdir(user_dir);
+#else
+    mkdir(user_dir, 0755);
+#endif
+    SET_ENV("BB_DC_TROPHY_STATE", "1");
+    uint32_t flags[4];
+
+    /* Nothing earned yet; 0.5.4's log counts as user 1's (earliest time kept, junk skipped). */
+    write_file("trophies.log", "3 500\n3 400\nbroken\n200 1\n");
+    runtime_trophy_context(10, 1);
+    runtime_trophy_context(20, 2);
+    assert(runtime_trophy_flags(10, flags) == 1 && flags[0] == 1u << 3 && !flags[1] && !flags[2] && !flags[3]);
+    assert(runtime_trophy_time(10, 3) == 400);
+    assert(runtime_trophy_flags(20, flags) == 0);
+
+    /* Unlocks: new, then already earned; bad ids refused; another user stays apart. */
+    assert(runtime_trophy_earn(10, 126, 1000) == 0);
+    assert(runtime_trophy_earn(10, 126, 2000) == 1);
+    assert(runtime_trophy_earn(10, 3, 2000) == 1);
+    assert(runtime_trophy_earn(10, 128, 2000) == -1 && runtime_trophy_earn(10, -1, 2000) == -1);
+    assert(runtime_trophy_earn(20, 5, 3000) == 0);
+    assert(exists("trophies/1.txt") && exists("trophies/2.txt") && !exists("trophies/1.txt.new"));
+
+    /* A restart: everything is read again from the files. */
+    runtime_trophy_reset();
+    runtime_trophy_context(30, 1);
+    runtime_trophy_context(40, 2);
+    assert(runtime_trophy_flags(30, flags) == 2 && flags[0] == 1u << 3 && flags[3] == 1u << 30);
+    assert(runtime_trophy_time(30, 126) == 1000 && runtime_trophy_time(30, 5) == 0);
+    assert(runtime_trophy_flags(40, flags) == 1 && flags[0] == 1u << 5);
+    /* An unknown context is the local user's. */
+    assert(runtime_trophy_flags(99, flags) == 2);
+
+    /* Without trophies.log the list alone keeps them. */
+    char p[600]; path(p, sizeof p, "trophies.log"); remove(p);
+    runtime_trophy_reset();
+    runtime_trophy_context(50, 1);
+    assert(runtime_trophy_flags(50, flags) == 2 && runtime_trophy_time(50, 3) == 400);
+
+    /* BB_DC_TROPHY_STATE=0: as 0.5.4, nothing reported and repeats accepted. */
+    SET_ENV("BB_DC_TROPHY_STATE", "0");
+    assert(runtime_trophy_flags(50, flags) == 0 && !flags[0] && !flags[3]);
+    assert(runtime_trophy_time(50, 126) == 0 && runtime_trophy_earn(50, 126, 5000) == 0);
+    SET_ENV("BB_DC_TROPHY_STATE", "1");
+    assert(runtime_trophy_time(50, 126) == 1000);
+
+    clean();
+    puts("PASS: trophies persist across restarts");
+    return 0;
+}

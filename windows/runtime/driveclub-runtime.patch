+extern "C" int bbgpu_guest_read(void* out, uintptr_t addr, uint64_t size) {
+    auto* r = MemopsRasterizer(addr, size);
+    if (!r || r->IsRangeGpuWritten(addr, size) || !runtime_memory_read_backing(addr, out, size)) {
+        return 0;
+    }
+    BbStats::guest_memops.fetch_add(1, std::memory_order_relaxed);
+    return 1;
+}
+
+extern "C" int bbgpu_guest_write(uintptr_t addr, const void* data, uint64_t size) {
+    auto* r = MemopsRasterizer(addr, size);
+    if (!r || r->IsRangeGpuWritten(addr, size)) {
+        return 0;
+    }
+    BbStats::guest_memops.fetch_add(1, std::memory_order_relaxed);
+    const auto* src = static_cast<const u8*>(data);
+    VAddr at = addr;
+    u64 left = size;
+    while (left) {
+        const u64 n = std::min<u64>(left, (at & ~VAddr{4095}) + 4096 - at);
+        if (r->IsRangeOnGpuPages(at, n)) {
+            if (!r->StoreUntracked(at, src, u32(n))) {
+                // Not eligible after all: the rest takes the usual write faults.
+                std::memcpy(reinterpret_cast<void*>(at), src, left);
+                return 1;
+            }
+        } else {
+            std::memcpy(reinterpret_cast<void*>(at), src, n); // at most a tracking fault
+        }
+        at += n;
+        src += n;
+        left -= n;
+    }
+    return 1;
+}

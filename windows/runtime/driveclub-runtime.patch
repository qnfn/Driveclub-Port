+    const vk::Rect2D scissor = {
+        .offset = {0, 0},
+        .extent = {state.width, state.height},
+    };
+    cmdbuf.setScissorWithCount(scissor);
+
+    cmdbuf.draw(3, 1, 0, 0);
+
+    scheduler.EndRendering();
+    scheduler.GetDynamicState().Invalidate();
+}

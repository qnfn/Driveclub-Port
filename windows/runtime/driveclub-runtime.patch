+        std::array<DcBuffer, 3> buffers; ///< frame, camera and object constants of the resolve
+        std::array<u32, 3> dword_offsets; ///< from each bound (aligned) range to the game's data
+        float tan_half_fov_y;
+    };
+    /// Before the TAA resolve: motion vectors, FSR into the scene color. True when it ran (the
+    /// caller then makes the resolve pass the scene through).
+    bool RunDriveclub(const DcInputs& inputs);
+
+    /// Frame generation's inputs from this frame's RunDriveclub: the depth (R32F copy, reversed

+// bbport: drops draws that cannot change anything: no color target (mask 0 or color
+// disabled), no depth/stencil target (both tests off), and no shader stage that writes memory.
+// On the PS4 such draws only feed occlusion counters, which this port answers with fixed
+// values (EventWrite ZpassDone in liverpool.cpp), so the host GPU would rasterize and shade
+// them for nothing. The GPU profile shows them as "pass ... [] depth -". On by default;
+// BB_SKIP_EMPTY_DRAWS=0 draws them. With BB_FRAME_STATS=1 each new shader pair that
+// qualifies is printed once, skipped or not.
+bool Rasterizer::SkipOutputlessDraw(const GraphicsPipeline* pipeline) {
+    static const bool skip = [] {
+        const char* value = std::getenv("BB_SKIP_EMPTY_DRAWS");
+        return !value || value[0] != '0';
+    }();
+    if ((!skip && !BbStats::enabled) || db_desc.first) {
+        return false;
+    }
+    const auto& key = pipeline->GetGraphicsKey();
+    for (u32 cb = 0; cb < u32(std::bit_width(key.mrt_mask)); ++cb) {
+        if (cb_descs[cb].first) {
+            return false;
+        }
+    }
+    for (const auto* stage : pipeline->GetStages()) {
+        if (!stage) {
+            continue;
+        }
+        if (stage->uses_dma) {
+            return false;
+        }
+        for (const auto& buffer : stage->buffers) {
+            if (buffer.is_written) {
+                return false;
+            }
+        }
+        for (const auto& image : stage->images) {
+            if (image.is_written || image.is_atomic) {
+                return false;
+            }
+        }
+    }
+    if (BbStats::enabled) {
+        const auto& regs = Regs();
+        const auto* ps = pipeline->GetStages()[u32(Shader::SwStage::Fragment)];
+        const u64 vs_hash = pipeline->GetStage(Shader::SwStage::Vertex).pgm_hash;
+        const u64 ps_hash = ps ? ps->pgm_hash : 0;
+        static std::mutex mutex;
+        static std::set<std::pair<u64, u64>> seen;
+        std::scoped_lock lock{mutex};
+        if (seen.emplace(vs_hash, ps_hash).second) {
+            std::printf("Empty draw (%s): vs %016llx ps %016llx, %u indices x %u instances, "
+                        "mrt_mask %#x, color mode %u, cb0 %s mask %#x, depth test %u (valid %u), "
+                        "stencil %u (valid %u)\n",
+                        skip ? "skipped" : "drawn", static_cast<unsigned long long>(vs_hash),
+                        static_cast<unsigned long long>(ps_hash), regs.num_indices,
+                        regs.num_instances.NumInstances(), u32(key.mrt_mask),
+                        u32(regs.color_control.mode), regs.color_buffers[0] ? "set" : "unset",
+                        regs.color_target_mask.GetMask(0), u32(regs.depth_control.depth_enable),
+                        u32(regs.depth_buffer.DepthValid()),
+                        u32(regs.depth_control.stencil_enable),
+                        u32(regs.depth_buffer.StencilValid()));
+        }
+    }
+    return skip;
+}
+
+void Rasterizer::MarkPass(const GraphicsPipeline* pipeline, const RenderState& state) {
+    auto* profiler = GpuProfiler::Get();
+    if (!profiler || !scheduler.WillBeginRendering(state)) {
+        return;
+    }
+    const auto& vs = pipeline->GetStage(Shader::SwStage::Vertex);
+    const auto* ps = pipeline->GetStages()[u32(Shader::SwStage::Fragment)];
+    std::array<u64, AmdGpu::NUM_COLOR_BUFFERS + 6> parts{};
+    parts[0] = state.width | u64(state.height) << 32;
+    parts[1] = vs.pgm_hash;
+    parts[2] = ps ? ps->pgm_hash : 0;
+    parts[3] = db_desc.first ? u64(texture_cache.GetImage(db_desc.first).info.pixel_format) : 0;
+    for (u32 cb = 0; cb < state.num_color_attachments && cb < AmdGpu::NUM_COLOR_BUFFERS; ++cb) {
+        parts[4 + cb] = cb_descs[cb].first
+                            ? u64(texture_cache.GetImage(cb_descs[cb].first).info.pixel_format) + 1
+                            : 0;
+    }
+    const u64 key = XXH3_64bits(parts.data(), sizeof(parts));
+    profiler->Mark(key, [&] {
+        std::string targets;
+        for (u32 cb = 0; cb < state.num_color_attachments; ++cb) {
+            targets += cb_descs[cb].first
+                           ? vk::to_string(texture_cache.GetImage(cb_descs[cb].first).info.pixel_format)
+                           : std::string{"-"};
+            targets += ' ';
+        }
+        return fmt::format("pass {}x{} [{}] depth {} vs {:016x} ps {:016x}", state.width,
+                           state.height, targets,
+                           db_desc.first ? vk::to_string(
+                                               texture_cache.GetImage(db_desc.first).info.pixel_format)
+                                         : std::string{"-"},
+                           vs.pgm_hash, ps ? ps->pgm_hash : 0);
+    });
+}
+
+void Rasterizer::NoteFrameStart() {
+    if (auto* profiler = GpuProfiler::Get()) {
+        profiler->BeginFrame();
+    }
+    const u64 frame = BbStats::gpu_frames.fetch_add(1, std::memory_order_relaxed) + 1;
+    // BB_BUFFER_STATS=1: how many earlier frames the GPU has not finished when the GPU thread
+    // starts a frame — the lag that decides whether guest memory can be read in place.
+    static const bool stats = [] {
+        const char* value = std::getenv("BB_BUFFER_STATS");
+        return value && value[0] == '1';
+    }();
+    if (!stats) {
+        return;
+    }
+    static std::array<u64, 16> frame_ticks{};
+    static std::array<u64, 17> lag_histogram{};
+    u32 lag = 0;
+    for (u32 back = 1; back < frame_ticks.size() && back < frame; ++back) {
+        const u64 tick = frame_ticks[(frame - back) % frame_ticks.size()];
+        if (tick && !scheduler.IsFree(tick)) {
+            lag = back;
+        }
+    }
+    ++lag_histogram[lag];
+    frame_ticks[frame % frame_ticks.size()] = scheduler.CurrentTick();
+    if (frame % 600 == 0) {
+        std::printf("GPU lag at frame start (frames not finished: count):");
+        for (u32 i = 0; i < lag_histogram.size(); ++i) {
+            if (lag_histogram[i]) {
+                std::printf(" %u:%llu", i, static_cast<unsigned long long>(lag_histogram[i]));
+            }
+        }
+        std::printf("\n");
+        lag_histogram = {};
+    }
+}
+
+} // namespace Vulkan

-                : 1u;
-        const bool proxy_candidate = sample_proxies && num_bindings == 1 &&
-                                     !image_desc.needs_native && !image_desc.is_written &&
-                                     mip_fallback_mode == Shader::MipStorageFallbackMode::None;

+    void OnDcDisplayDraw(VideoCore::ImageId display);
+    std::atomic<u32> fg_handed{0};     ///< inputs made (BB_FG_STATS)
+    std::atomic<u32> display_draws{0}; ///< draws into the display buffer (BB_FG_STATS)
+    [[nodiscard]] bool TakeFrameGenInputs(FrameGenInputs& out) {

+/// A canvas of any size, premultiplied, for the DriveClub icons.
+struct DcCanvas {
+    int w, h;
+    std::vector<std::array<float, 4>> px;
+    DcCanvas(int width, int height) : w(width), h(height), px(size_t(width) * height) {}
+    void Blend(int x, int y, Color c, float coverage) {
+        if (x < 0 || y < 0 || x >= w || y >= h || coverage <= 0.0f) return;
+        const float a = c.a / 255.0f * std::min(coverage, 1.0f);
+        auto& p = px[size_t(y) * w + x];
+        p[0] = c.r * a + p[0] * (1 - a);
+        p[1] = c.g * a + p[1] * (1 - a);
+        p[2] = c.b * a + p[2] * (1 - a);
+        p[3] = 255.0f * a + p[3] * (1 - a);
+    }
+};
+
+Color Mix(Color a, Color b, float t) {
+    t = std::clamp(t, 0.0f, 1.0f);
+    return {a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t, a.a + (b.a - a.a) * t};
+}
+
+/// Fills a shape given by `inside(px, py)` (4x4 samples per pixel), coloured top to bottom
+/// from `top` to `bottom` over [y0, y1].
+template <typename Inside>
+void Fill(DcCanvas& c, float y0, float y1, Color top, Color bottom, Inside inside) {
+    for (int y = 0; y < c.h; ++y) {
+        const Color color = Mix(top, bottom, (y + 0.5f - y0) / std::max(1.0f, y1 - y0));
+        for (int x = 0; x < c.w; ++x) {
+            int n = 0;
+            for (int sy = 0; sy < 4; ++sy) {
+                for (int sx = 0; sx < 4; ++sx) n += inside(x + (sx + 0.5f) / 4, y + (sy + 0.5f) / 4);
+            }
+            c.Blend(x, y, color, n / 16.0f);
+        }
+    }
+}
+
+void Disc(DcCanvas& c, float cx, float cy, float r, Color top, Color bottom) {
+    Fill(c, cy - r, cy + r, top, bottom,
+         [=](float px, float py) { return (px - cx) * (px - cx) + (py - cy) * (py - cy) <= r * r; });
+}
+
+/// Rounded rectangle; `r_top` and `r_bottom` are the corner radii of each edge.
+void Rounded(DcCanvas& c, float x0, float y0, float x1, float y1, float r_top, float r_bottom, Color top,
+             Color bottom) {
+    Fill(c, y0, y1, top, bottom, [=](float px, float py) {
+        if (px < x0 || px >= x1 || py < y0 || py >= y1) return false;
+        const float r = py < (y0 + y1) / 2 ? r_top : r_bottom;
+        const float cx = std::clamp(px, x0 + r, x1 - r), cy = std::clamp(py, y0 + r, y1 - r);
+        return (px - cx) * (px - cx) + (py - cy) * (py - cy) <= r * r;
+    });
+}
+
+/// Bold text centred on (cx, cy) at `size` pixels (smaller if wider than `max_width`), with a
+/// dark outline when `outline` is set.
+void DcText(DcCanvas& c, const std::string& text, float cx, float cy, float size, float max_width, Color color,
+            bool outline) {
+    if (!g_font_ready || text.empty()) return;
+    const auto cps = Codepoints(text);
+    while (size > 6 && TextWidth(cps, stbtt_ScaleForPixelHeight(&g_font, size)) > max_width) size -= 0.5f;
+    const float scale = stbtt_ScaleForPixelHeight(&g_font, size);
+    int ascent, descent, gap;
+    stbtt_GetFontVMetrics(&g_font, &ascent, &descent, &gap);
+    const float baseline = cy + ascent * scale * 0.73f / 2;
+    const auto draw = [&](float dx, float dy, Color ink) {
+        float x = cx - TextWidth(cps, scale) / 2 + dx;
+        for (size_t i = 0; i < cps.size(); ++i) {
+            int w, h, xoff, yoff;
+            unsigned char* bitmap = stbtt_GetCodepointBitmapSubpixel(&g_font, scale, scale, x - std::floor(x), 0,
+                                                                    cps[i], &w, &h, &xoff, &yoff);
+            for (int by = 0; by < h; ++by) {
+                for (int bx = 0; bx < w; ++bx) {
+                    c.Blend(int(std::floor(x)) + xoff + bx, int(std::round(baseline + dy)) + yoff + by, ink,
+                            bitmap[by * w + bx] / 255.0f);
+                }
+            }
+            stbtt_FreeBitmap(bitmap, nullptr);
+            int advance, lsb;
+            stbtt_GetCodepointHMetrics(&g_font, cps[i], &advance, &lsb);
+            x += advance * scale;
+            if (i + 1 < cps.size()) x += stbtt_GetCodepointKernAdvance(&g_font, cps[i], cps[i + 1]) * scale;
+        }
+    };
+    if (outline) {
+        const Color dark{20, 20, 20, 200};
+        for (const float o : {-1.2f, 1.2f}) {
+            draw(o, 0, dark);
+            draw(0, o, dark);
+            draw(o * 0.7f, o * 0.7f, dark);
+            draw(o * 0.7f, -o * 0.7f, dark);
+        }
+    }
+    for (const float bold : {-0.35f, 0.0f, 0.35f}) draw(bold, 0, color);
+}
+
+constexpr Color kWhite{255, 255, 255, 255};
+constexpr Color kInk{34, 34, 38, 255};

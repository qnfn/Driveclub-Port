+    // The early copy holds what would be copied now when no GPU write was marked in the window
+    // since and the ranges are the same (job.copies are packed from 0, the early ones are not).
+    const u64 write_seq = memory_tracker->GpuWriteSeq(job.window, ReadbackWindowSize);

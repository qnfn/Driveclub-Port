-void Rasterizer::BindTextures(const Shader::Info& stage, const PreparedStage* prepared,
-                              Shader::Backend::Bindings& binding, u32& write_index,
-                              bool& barrier, bool on_helper) {
-    const u32 first_image_idx = image_infos.size();

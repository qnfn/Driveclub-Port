+/// The Xbox 360's glossy face buttons: the colour darker at the bottom, a dark rim, a soft
+/// highlight in the top half and a white letter.
+void Gem(DcCanvas& c, const char* letter, Color light, Color dark) {
+    const float cx = c.w / 2.0f, cy = c.h / 2.0f, r = c.w * 0.46f;
+    Disc(c, cx, cy, r, {28, 28, 30, 255}, {12, 12, 14, 255});
+    Disc(c, cx, cy, r - 2.2f, light, dark);
+    Fill(c, cy - r, cy, {255, 255, 255, 120}, {255, 255, 255, 10}, [=](float px, float py) {
+        const float ex = (px - cx) / (r * 0.72f), ey = (py - (cy - r * 0.42f)) / (r * 0.46f);
+        return ex * ex + ey * ey <= 1.0f;
+    });
+    // White on the colour only: a dark outline would put three colours in the letter's blocks,
+    // more than one BC7 colour line keeps.
+    DcText(c, letter, cx, cy + 0.5f, c.h * 0.56f, c.w * 0.6f, kWhite, false);
+}

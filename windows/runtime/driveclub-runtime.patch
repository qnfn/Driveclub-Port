+/* DCport: freeze report. When no frame has been flipped for 1.5 s, each other thread is paused
+ * just long enough to copy its registers and the top of its stack, and the threads that are in
+ * game code are printed with their call chain: what the game waits for. Once per freeze, at
+ * most eight; BB_FREEZE_REPORT=0 turns it off. */
+extern unsigned long long bbgpu_flips;
+enum { FREEZE_FRAMES = 12, FREEZE_SCAN = 96 };
+static int guest_code(uintptr_t a) { return image && a-(uintptr_t)image<0x20000000; }
+static void freeze_report(unsigned long stalled_ms) {
+    fprintf(stderr,"Freeze: no frame for %lu ms; game threads:\n",stalled_ms);
+    HANDLE snap=CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD,0);
+    if (snap==INVALID_HANDLE_VALUE) return;
+    THREADENTRY32 te; te.dwSize=sizeof(te);
+    const DWORD self=GetCurrentThreadId(), pid=GetCurrentProcessId();
+    int others=0;
+    for (BOOL more=Thread32First(snap,&te); more; more=Thread32Next(snap,&te)) {
+        if (te.th32OwnerProcessID!=pid || te.th32ThreadID==self) continue;
+        HANDLE t=OpenThread(THREAD_SUSPEND_RESUME|THREAD_GET_CONTEXT|THREAD_QUERY_INFORMATION,FALSE,te.th32ThreadID);
+        if (!t) continue;
+        CONTEXT c; memset(&c,0,sizeof(c)); c.ContextFlags=CONTEXT_FULL;
+        uintptr_t chain[FREEZE_FRAMES]={0}, stack[FREEZE_SCAN]={0};
+        int ok=0;
+        /* Nothing that can take a lock while the thread is paused: only kernel calls. */
+        if (SuspendThread(t)!=(DWORD)-1) {
+            ok=GetThreadContext(t,&c);
+            if (ok) {
+                SIZE_T got=0;
+                ReadProcessMemory(GetCurrentProcess(),(void *)(uintptr_t)c.Rsp,stack,sizeof(stack),&got);
+                uintptr_t rbp=(uintptr_t)c.Rbp;
+                for (int i=0; i<FREEZE_FRAMES && rbp; ++i) {
+                    uintptr_t frame[2]={0};
+                    if (!ReadProcessMemory(GetCurrentProcess(),(void *)rbp,frame,sizeof(frame),&got) || got!=sizeof(frame)) break;
+                    chain[i]=frame[1];
+                    if (frame[0]<=rbp) break;
+                    rbp=frame[0];
+                }
+            }
+            ResumeThread(t);
+        }
+        CloseHandle(t);
+        if (!ok) continue;
+        int in_game=guest_code((uintptr_t)c.Rip);
+        for (int i=0; i<FREEZE_FRAMES && !in_game; ++i) in_game=guest_code(chain[i]);
+        for (int i=0; i<FREEZE_SCAN && !in_game; ++i) in_game=guest_code(stack[i]);
+        if (!in_game) { ++others; continue; }
+        char where[MAX_PATH+64];
+        describe_address(where,sizeof(where),(uintptr_t)c.Rip);
+        fprintf(stderr,"  thread %lu at %s\n",te.th32ThreadID,where);
+        for (int i=0; i<FREEZE_FRAMES && chain[i]; ++i) {
+            describe_address(where,sizeof(where),chain[i]);
+            fprintf(stderr,"    #%d %s\n",i,where);
+        }
+        /* Game return addresses on the stack: host code without frame pointers (the wait
+         * itself) hides its guest caller from the rbp chain. */
+        for (int i=0, shown=0; i<FREEZE_SCAN && shown<6; ++i) {
+            if (!guest_code(stack[i])) continue;
+            describe_address(where,sizeof(where),stack[i]);
+            fprintf(stderr,"    [rsp+0x%x] %s\n",i*8,where);
+            ++shown;
+        }
+    }
+    CloseHandle(snap);
+    fprintf(stderr,"Freeze: %d other threads (host only)\n",others);
+    fflush(stderr);
+}
+static DWORD WINAPI freeze_monitor(void *unused) {
+    (void)unused;
+    unsigned long long seen=__atomic_load_n(&bbgpu_flips,__ATOMIC_RELAXED);
+    ULONGLONG since=GetTickCount64();
+    int reported=0, reports=0;
+    for (;;) {
+        Sleep(100);
+        const unsigned long long flips=__atomic_load_n(&bbgpu_flips,__ATOMIC_RELAXED);
+        const ULONGLONG now=GetTickCount64();
+        if (flips!=seen) {
+            if (reported) fprintf(stderr,"Freeze: over after %llu ms\n",(unsigned long long)(now-since));
+            seen=flips; since=now; reported=0;
+            continue;
+        }
+        /* Past the boot (its loading screens flip rarely), once per freeze. */
+        if (!reported && flips>2000 && now-since>=1500) {
+            freeze_report((unsigned long)(now-since));
+            reported=1;
+            if (++reports>=8) return 0;
+        }
+    }
+}
+static void start_freeze_monitor(void) {
+    const char *env=getenv("BB_FREEZE_REPORT");
+    if (env && env[0]=='0') return;
+    HANDLE t=CreateThread(NULL,0,freeze_monitor,NULL,0,NULL);
+    if (t) CloseHandle(t);
+}

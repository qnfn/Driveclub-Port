+    static const char* const ps_names[] = {"L1", "R1", "L2", "R2"};
+    const auto& t = DcTextures[icon];
+    DcCanvas c(t.width, t.height);
+    switch (icon) {
+    case DcCross: case DcCircle: case DcSquare: case DcTriangle: {
+        static const char* const letters[] = {"A", "B", "X", "Y"};
+        static const Color light[] = {{120, 200, 60, 255}, {236, 74, 60, 255}, {70, 140, 236, 255}, {250, 206, 60, 255}};
+        static const Color dark[] = {{40, 120, 20, 255}, {150, 20, 16, 255}, {16, 64, 160, 255}, {196, 132, 8, 255}};
+        if (style == DcXbox360) Gem(c, letters[icon], light[icon], dark[icon]);
+        else if (style == DcXboxOne) FlatFace(c, letters[icon], light[icon]);
+        else PsFace(c, icon);
+        break;
+    }
+    case DcL1: case DcR1: case DcL2: case DcR2: {
+        const int i = icon - DcL1;
+        const bool trigger = icon == DcL2 || icon == DcR2;
+        if (style == DcXbox360) Shoulder360(c, xbox_names[i], trigger);
+        else DarkShoulder(c, style == DcPs5 ? ps_names[i] : xbox_names[i], trigger);
+        break;
+    }
+    case DcL3: case DcR3: {
+        const bool left = icon == DcL3;
+        if (style == DcXbox360) Stick360(c, left ? "LS" : "RS");
+        else DarkStick(c, style == DcPs5 ? (left ? "L3" : "R3") : (left ? "LS" : "RS"));
+        break;
+    }
+    case DcTouchpad: case DcTouchpadSmall:
+        if (style == DcXbox360) Back360(c);
+        else if (style == DcXboxOne) View(c);
+        else Touchpad(c);
+        break;
+    default: break;
+    }
+    std::vector<uint8_t> out(size_t(t.width) * t.height * 4);
+    for (size_t i = 0; i < c.px.size(); ++i) {
+        const float a = c.px[i][3];
+        for (int k = 0; k < 3; ++k) {
+            // Straight colour; fully transparent pixels take a dark grey so filtering at the
+            // edges does not bleed a bright fringe.
+            const float v = a > 0.5f ? c.px[i][k] * 255.0f / a : 20.0f;
+            out[i * 4 + k] = uint8_t(std::clamp(std::lround(v), 0l, 255l));
+        }
+        out[i * 4 + 3] = uint8_t(std::clamp(std::lround(a), 0l, 255l));
+    }
+    return out;
+}
+
+std::vector<uint8_t> EncodeDc(DcIcon icon, const std::vector<uint8_t>& rgba, const std::vector<uint8_t>& original) {
+    const auto& t = DcTextures[icon];
+    std::vector<uint8_t> out = original;
+    out.resize(DcBytes(icon));
+    const int pitch = (t.width + 31) / 32 * 32;
+    for (int by = 0; by < t.height / 4; ++by) {
+        for (int bx = 0; bx < t.width / 4; ++bx) {
+            EncodeBlock(rgba.data(), t.width, bx, by, &out[TiledBlockOffset(bx, by, pitch)]);
+        }
+    }
+    return out;
+}
+
 } // namespace BbPromptIcons

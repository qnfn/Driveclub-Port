+bool BufferCache::ReleaseSharedRead(VAddr device_addr, u64 size) {
+    // Only pages whose GPU-written ranges are all small (counters and the like) are released:
+    // a page with GPU-written data (grass placement, written once at load) could otherwise be
+    // read stale within the frame it was released in (floating grass).
+    static const u64 max_range = [] {
+        const char* env = std::getenv("BB_READBACK_FASTPATH_MAX");
+        return env ? std::strtoull(env, nullptr, 10) : u64{1024};
+    }();
+    {
+        std::scoped_lock lk{gpu_ranges_mutex};
+        if (gpu_modified_ranges.Intersects(device_addr, size)) {
+            return false;
+        }
+        const VAddr page = Common::AlignDown(device_addr, TRACKER_BYTES_PER_PAGE);
+        bool small = true;
+        gpu_modified_ranges.ForEachInRange(page, TRACKER_BYTES_PER_PAGE,
+                                           [&](VAddr start, VAddr end) {
+                                               small &= end - start <= max_range;
+                                           });
+        if (!small) {
+            return false;
+        }
+    }
+    // The read only touches the game's own bytes, which guest memory already holds. A download of
+    // the window still in flight keeps it waiting (it may hold GPU data the read is next to).
+    {
+        std::scoped_lock lk{readback_mutex};
+        if (IsReadbackPending(Common::AlignDown(device_addr, ReadbackWindowSize),
+                              ReadbackWindowSize)) {
+            return false;
+        }
+    }
+    memory_tracker->ReleaseRead(device_addr, size);
+    released_reads.fetch_add(1, std::memory_order_relaxed);
+    return true;
+}
+
+bool BufferCache::WaitPendingReadback(VAddr window, VAddr device_addr, u64 size, bool is_write) {
+    {
+        std::unique_lock lk{readback_mutex};
+        if (!IsReadbackPending(window, ReadbackWindowSize)) {
+            return false;
+        }
+        readback_cv.wait(lk, [&] { return !IsReadbackPending(window, ReadbackWindowSize); });
+    }
+    return ReadbackResolved(device_addr, size, is_write);
+}

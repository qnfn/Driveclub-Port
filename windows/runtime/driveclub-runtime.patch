-void Rasterizer::DrawIndirect(bool is_indexed, VAddr arg_address, u32 offset, u32 stride,
-                              u32 max_count, VAddr count_address, u16 vertex_sgpr_offset,
-                              u16 instance_sgpr_offset) {

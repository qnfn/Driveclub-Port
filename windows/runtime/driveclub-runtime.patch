+std::string ForeignLines() {
+    static constexpr const char* own[] = {
+        "upscaler", "preset", "sharpen", "sharpness", "jitter", "reactive", "object_motion",
+        "reactive_scale", "reactive_threshold", "reactive_max", "debug_view", "show_fps",

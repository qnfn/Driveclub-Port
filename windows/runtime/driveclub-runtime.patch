-void Rasterizer::DispatchIndirectRecord(const ComputePipeline* pipeline, VAddr address,
-                                        u32 size) {
-    scheduler.PopPendingOperations();
-    const u32 offset = 0;
-
-    if (!BindResources(pipeline)) {

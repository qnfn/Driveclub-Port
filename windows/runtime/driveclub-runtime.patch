+void Runtime::InlineBytes(VideoCore::Buffer* dst, u64 offset, const void* data, u32 size) {
+    scheduler.EndRendering();
+
+    if (IsBufferAccessed(dst, offset, size, true)) {
+        FlushBarriers();
+    }

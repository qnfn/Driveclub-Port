+                .size = end - start,
+            });
+            // Align up to avoid cache conflicts
+            total_size_bytes += Common::AlignUp(end - start, 64);
+        };
+        gpu_modified_ranges.ForEachInRange(address, size, add_download);
+        gpu_modified_ranges.Subtract(address, size);
+    });
+    return total_size_bytes;
+}
+
+bool BufferCache::OffloadReadback(VAddr device_addr, u64 size, bool is_write) {
+    const VAddr window = Common::AlignDown(device_addr, ReadbackWindowSize);
+    if (device_addr + size > window + ReadbackWindowSize) {
+        return false;
+    }
+    // A request still GPU modified after two rounds of its own takes the synchronous download,
+    // which copies and unmarks in one GPU thread command.
+    u32 attempts = 0;
+    while (attempts < 2) {
+        if (WaitPendingReadback(window, device_addr, size, is_write)) {
+            return true;
+        }
+        Readback job{.window = window};
+        liverpool->SendCommand<true>([this, &job] { RecordReadback(job); });
+        if (job.busy) {
+            std::unique_lock lk{readback_mutex};
+            readback_cv.wait(lk, [&] { return !IsReadbackPending(window, ReadbackWindowSize); });
+        } else {
+            ++attempts;
+            if (!job.copies.empty()) {
+                scheduler.GetWorkSemaphore()->Wait(job.tick);
+                FinishReadback(job);
+            }
+        }
+        bool resolved = true;
+        if (is_write) {
+            // Marks the range CPU modified if it is GPU clean.
+            memory_tracker->InvalidateRegion(device_addr, size, [&resolved] { resolved = false; });
+        } else {
+            resolved = !memory_tracker->IsRegionGpuModified(device_addr, size);
+        }
+        if (resolved) {
+            return true;
+        }
+    }
+    return false;
+}
+
+bool BufferCache::WaitPendingReadback(VAddr window, VAddr device_addr, u64 size, bool is_write) {
+    {
+        std::unique_lock lk{readback_mutex};
+        if (!IsReadbackPending(window, ReadbackWindowSize)) {
+            return false;
+        }
+        readback_cv.wait(lk, [&] { return !IsReadbackPending(window, ReadbackWindowSize); });
+    }
+    if (is_write) {
+        bool resolved = true;
+        memory_tracker->InvalidateRegion(device_addr, size, [&resolved] { resolved = false; });
+        return resolved;
+    }
+    return !memory_tracker->IsRegionGpuModified(device_addr, size);
+}
+
+void BufferCache::RecordReadback(Readback& job) {
+    const u64 block = job.window >> block_shift;
+    const auto* arena = GetArena(block, block);
+    {
+        std::scoped_lock lk{readback_mutex};
+        if (IsReadbackPending(job.window, ReadbackWindowSize)) {
+            job.busy = true;
+            return;
+        }
+    }
+    const u64 total_size_bytes = ClaimReadbackWindow(arena, job.window, job.copies);
+    if (total_size_bytes == 0) {
+        return;
+    }
+    // Held until FinishReadback releases it; the pool reuses it once the GPU passes that release.
+    job.staging = staging_pool.Request(total_size_bytes, MemoryType::HostCached, 16, true);
+    for (auto& copy : job.copies) {
+        copy.dstOffset += job.staging.offset;
+    }
+    job.arena_base = arena->cpu_addr;
+    job.write_seq = memory_tracker->GpuWriteSeq(job.window, ReadbackWindowSize);
+    runtime.CopyBuffer(arena, job.staging.buffer, job.copies);
+    job.tick = scheduler.CurrentTick();
+    // Submitted without waiting: the faulting thread waits for this tick, the GPU thread goes on.
+    scheduler.Flush();
+}
+
+void BufferCache::FinishReadback(const Readback& job) {
+    job.staging.Invalidate();
+    // The write-back runs ahead of the verdict: other downloads of the window wait while this one
+    // is pending, and a vetoed window stays GPU modified.
+    for (const auto& copy : job.copies) {
+        auto* dst_addr = std::bit_cast<u8*>(job.arena_base + copy.srcOffset);
+        memory->TryWriteBacking(
+            dst_addr, job.staging.mapped + (copy.dstOffset - job.staging.offset), copy.size);
+    }
+    const bool unmarked = memory_tracker->TryUnmarkRegionAsGpuModified(
+        job.window, ReadbackWindowSize, job.write_seq);
+    {
+        std::scoped_lock lk{readback_mutex};
+        if (!unmarked) {
+            for (const auto& copy : job.copies) {
+                readback_returns.emplace_back(job.arena_base + copy.srcOffset, copy.size);
+            }
+        }
+        std::erase(pending_readbacks, job.window);
+    }
+    readback_cv.notify_all();
+    // The staging pool belongs to the GPU thread.
+    liverpool->SendCommand([this, staging = job.staging] { staging_pool.FreeDeferred(staging); });
+}
+
+bool BufferCache::IsReadbackPending(VAddr addr, u64 size) const {
+    return std::ranges::any_of(pending_readbacks, [&](VAddr window) {
+        return window < addr + size && addr < window + ReadbackWindowSize;
+    });
+}
+
+u64 BufferCache::ClaimReadbackWindow(const Buffer* arena, VAddr window, DownloadCopies& copies) {
+    std::scoped_lock lk{readback_mutex};
+    if (IsReadbackPending(window, ReadbackWindowSize)) {
+        return 0;
+    }
+    MergeReadbackReturns();
+    const u64 total_size_bytes = CollectDownloads(arena, window, ReadbackWindowSize, copies);
+    if (total_size_bytes != 0) {
+        pending_readbacks.push_back(window);
+    }
+    return total_size_bytes;
+}
+
+void BufferCache::MergeReadbackReturns() {
+    for (const auto& [addr, size] : readback_returns) {
+        gpu_modified_ranges.Add(addr, size);
+    }
+    readback_returns.clear();
+}
+
+void BufferCache::AsyncReadbackFrame() {
+    static const bool enabled = [] {
+        const char* env = std::getenv("BB_ASYNC_READBACK");
+        return EmulatorSettings.GetReadbacksMode() == GpuReadbacksMode::Disabled &&
+               !(env && env[0] == '0');
+    }();
+    std::vector<std::pair<VAddr, u64>> ranges;
+    {
+        std::scoped_lock lk{frame_written_mutex};
+        ranges.swap(frame_written);
+    }
+    if (!enabled || ranges.empty()) {
+        return;
+    }
+    // Merge overlapping and touching ranges.
+    std::sort(ranges.begin(), ranges.end());
+    std::vector<std::pair<VAddr, u64>> merged;
+    for (const auto& [addr, size] : ranges) {
+        if (!merged.empty() && addr <= merged.back().first + merged.back().second) {
+            const VAddr end = std::max(merged.back().first + merged.back().second, addr + size);
+            merged.back().second = end - merged.back().first;
+        } else {
+            merged.emplace_back(addr, size);
+        }
+    }
+    struct Readback {
+        VAddr addr;
+        u64 size;
+        u64 staging_offset;
+    };
+    std::vector<Readback> readbacks;
+    u64 total = 0;
+    // bbport: over the budget, small ranges (exposure values and other CPU-read results) go
+    // first; cutting by address dropped the same high ranges every busy frame.
+    u64 merged_bytes = 0;
+    for (const auto& range : merged) {
+        merged_bytes += Common::AlignUp(range.second, 64);
+    }
+    if (merged_bytes > AsyncReadbackMaxFrameBytes) {
+        std::stable_sort(merged.begin(), merged.end(),
+                         [](const auto& a, const auto& b) { return a.second < b.second; });
+    }
+    u64 dropped = 0;
+    for (const auto& [addr, size] : merged) {
+        if (total + size > AsyncReadbackMaxFrameBytes) {
+            ++dropped;
+            continue;
+        }
+        readbacks.push_back({addr, size, total});
+        total += Common::AlignUp(size, 64);
+        BbStats::async_ranges[size <= 256 ? 0 : size <= 4_KB ? 1 : size <= 64_KB ? 2 : 3]
+            .fetch_add(1, std::memory_order_relaxed);
+        BbStats::async_bytes.fetch_add(size, std::memory_order_relaxed);
+    }
+    if (dropped) {
+        static std::atomic<int> reported{0};
+        if (reported.fetch_add(1) < 8) {
+            std::printf("Async readback: %llu ranges over the %llu MiB frame budget skipped "
+                        "(%llu MiB written)\n",
+                        static_cast<unsigned long long>(dropped),
+                        static_cast<unsigned long long>(AsyncReadbackMaxFrameBytes >> 20),
+                        static_cast<unsigned long long>(merged_bytes >> 20));
+        }
+    }
+    if (readbacks.empty()) {
+        return;
+    }
+    const auto download = staging_pool.Request(total, VideoCore::MemoryType::HostCached, 64, true);
+    // One copy command per arena (each carries its own barriers).
+    std::vector<std::pair<const Buffer*, boost::container::small_vector<vk::BufferCopy, 16>>> batches;
+    for (const auto& r : readbacks) {
+        const u32 first_block = r.addr >> block_shift;
+        const u32 last_block = (r.addr + r.size - 1) >> block_shift;
+        const Buffer* arena = GetArena(first_block, last_block);
+        if (!arena || r.addr < arena->cpu_addr ||
+            r.addr + r.size > arena->cpu_addr + arena->size_bytes) {
+            continue;
+        }
+        auto it = std::find_if(batches.begin(), batches.end(),
+                               [arena](const auto& b) { return b.first == arena; });
+        if (it == batches.end()) {
+            it = batches.emplace(batches.end(), arena,
+                                 boost::container::small_vector<vk::BufferCopy, 16>{});
+        }
+        it->second.push_back(vk::BufferCopy{
+            .srcOffset = r.addr - arena->cpu_addr,
+            .dstOffset = download.offset + r.staging_offset,
+            .size = r.size,
+        });
+    }
+    for (const auto& [arena, copies] : batches) {
+        runtime.CopyBuffer(arena, download.buffer, copies);
+    }
+    // Written once the GPU has finished the frame. A range the CPU wrote since keeps the CPU's
+    // data (it is uploaded to the GPU at its next use).
+    scheduler.DeferPriorityOperation([this, download, readbacks = std::move(readbacks)] {
+        download.Invalidate();
+        auto* memory = Core::Memory::Instance();
+        static const bool copy_only = [] {
+            const char* env = std::getenv("BB_ASYNC_READBACK");
+            return env && env[0] == '2'; // measurements: GPU copies without the guest writes
+        }();
+        for (const auto& r : readbacks) {
+            if (copy_only) {
+                break;
+            }
+            if (memory_tracker->IsRegionCpuModified(r.addr, r.size)) {
+                continue;
+            }
+            memory->TryWriteBacking(std::bit_cast<u8*>(r.addr), download.mapped + r.staging_offset,
+                                    r.size);
+        }
+        staging_pool.FreeDeferred(download);
+    });
+}

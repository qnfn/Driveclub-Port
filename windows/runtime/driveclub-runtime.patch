diff --git a/src/runtime_dc_hooks.c b/src/runtime_dc_hooks.c
new file mode 100644
index 0000000..600906b
--- /dev/null
+++ b/src/runtime_dc_hooks.c
@@ -0,0 +1,292 @@
+/* DCport: small fixes in DRIVECLUB's own code (v01.28 eboot), installed by probe.c after the
+ * patches and before the image is made executable. Each fix first compares the bytes it
+ * replaces with the 1.28 code and leaves the game alone when they differ (another version,
+ * or a patch that changed them).
+ *
+ * Image offsets are the eboot's own addresses: link_modules.py places the eboot at offset 0. */
+#define _GNU_SOURCE
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "runtime.h"
+#ifdef _WIN32
+#include <windows.h>
+#else
+#include <sys/mman.h>
+#include <unistd.h>
+#endif
+
+static unsigned char *dc_image;
+
+/* VAR=0 turns a fix off; the second name is driveclub-recomp's, accepted as well. */
+static int fix_enabled(const char *name, const char *recomp_name) {
+    const char *value = getenv(name);
+    if (!value && recomp_name) value = getenv(recomp_name);
+    return !(value && *value == '0');
+}
+
+/* jmp qword [rip+0]; .quad target (14 bytes, any distance) */
+static void write_jump(unsigned char *at, uintptr_t target) {
+    static const unsigned char jump[6] = {0xff, 0x25, 0, 0, 0, 0};
+    memcpy(at, jump, sizeof jump);
+    memcpy(at + 6, &target, 8);
+}
+
+/* One executable page for the trampolines (the game's first instructions, then a jump back). */
+static unsigned char *trampoline_page;
+static size_t trampoline_used;
+static unsigned char *trampoline(const unsigned char *code, size_t length, uintptr_t resume) {
+    if (!trampoline_page) {
+#ifdef _WIN32
+        trampoline_page = VirtualAlloc(NULL, 4096, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+#else
+        void *page = mmap(NULL, 4096, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+        trampoline_page = page == MAP_FAILED ? NULL : page;
+#endif
+        if (!trampoline_page) return NULL;
+        memset(trampoline_page, 0xcc, 4096);
+    }
+    if (trampoline_used + length + 14 > 4096) return NULL;
+    unsigned char *at = trampoline_page + trampoline_used;
+    memcpy(at, code, length);
+    write_jump(at + length, resume);
+    trampoline_used += (length + 14 + 15) & ~(size_t)15;
+    return at;
+}
+static void seal_trampolines(void) {
+    if (!trampoline_page) return;
+#ifdef _WIN32
+    DWORD old;
+    VirtualProtect(trampoline_page, 4096, PAGE_EXECUTE_READ, &old);
+    FlushInstructionCache(GetCurrentProcess(), trampoline_page, 4096);
+#else
+    mprotect(trampoline_page, 4096, PROT_READ | PROT_EXEC);
+#endif
+}
+
+/* --- Menu key repeat at any frame rate (#109) ----------------------------------------------
+ * The menus' button reader (0x28e630, once per frame) repeats a held d-pad direction by
+ * counting frames: 7 frames, then one less each repeat down to 1. At 60 FPS that is twice as
+ * fast as the 30 FPS the game was made for. The reader still runs every frame (presses,
+ * releases and sticks are unchanged); afterwards its repeat result and counters are replaced
+ * by the same countdown stepped in 30 Hz ticks of real time (0x79690, the game's frame time
+ * in seconds). BB_DC_MENU_REPEAT=0 turns it off.
+ * Idea from driveclub-recomp 1724b17 / PR #157 (HeyOkay).
+ *
+ * The reader's object: +0x08 held buttons, +0x0c pressed this frame (new presses, then the
+ * repeats), +0x14 held last frame, +0x40 repeat interval, +0x44 frames to the next repeat.
+ * The repeat table (0x15c1ca0, 25 entries of 24 bytes: the button's bit, ..., +16 "repeats")
+ * says which buttons repeat (the d-pad). */
+enum { MENU_READER = 0x28e630, MENU_REPEAT_RESET = 0x28e75b, MENU_FRAME_TIME = 0x79690,
+       MENU_REPEAT_TABLE = 0x15c1ca0, MENU_REPEAT_ENTRIES = 25 };
+typedef void (ABI *MenuReader)(void *self, void *input);
+typedef float (ABI *MenuFrameTime)(void);
+static MenuReader menu_reader_original;
+static uint32_t menu_repeat_buttons;
+
+static void menu_repeat_tick(int32_t *interval, int32_t *left, uint32_t held, uint32_t *pressed) {
+    if (*left > 0) { --*left; return; }
+    *interval = *interval > 2 ? *interval - 1 : 1;
+    *left = *interval;
+    *pressed |= held & menu_repeat_buttons;
+}
+
+static ABI void menu_reader(void *self, void *input) {
+    /* Seconds not yet counted as 30 Hz ticks, per reader object (the menus use a few). */
+    static __thread struct { void *self; double seconds; } clocks[16];
+    unsigned char *reader = self;
+    int32_t interval, left;
+    memcpy(&interval, reader + 0x40, 4);
+    memcpy(&left, reader + 0x44, 4);
+    menu_reader_original(self, input);
+    unsigned slot = 0;
+    while (slot < 16 && clocks[slot].self && clocks[slot].self != self) ++slot;
+    if (slot == 16) return; /* more readers than expected: the game's own timing */
+    clocks[slot].self = self;
+    uint32_t held, before;
+    memcpy(&held, reader + 0x08, 4);
+    memcpy(&before, reader + 0x14, 4);
+    const uint32_t fresh = held & ~before;
+    /* Nothing held, or a new press: the game's result stands (a new press restarts at 7). */
+    if (!held || fresh) { clocks[slot].seconds = 0; return; }
+    double seconds = ((MenuFrameTime)(dc_image + MENU_FRAME_TIME))();
+    if (!(seconds >= 0) || seconds > 1) seconds = 0;
+    seconds += clocks[slot].seconds;
+    const double tick = 1.0 / 30.0;
+    unsigned ticks = (unsigned)((seconds + 1e-6) / tick);
+    if (ticks > 30) ticks = 30;
+    seconds -= ticks * tick;
+    clocks[slot].seconds = seconds > 0 ? seconds : 0;
+    uint32_t pressed = 0; /* the game's frame-counted repeat is replaced */
+    for (unsigned i = 0; i < ticks; ++i) menu_repeat_tick(&interval, &left, held, &pressed);
+    memcpy(reader + 0x0c, &pressed, 4);
+    memcpy(reader + 0x40, &interval, 4);
+    memcpy(reader + 0x44, &left, 4);
+}
+
+static void install_menu_repeat(uint64_t size) {
+    if (!fix_enabled("BB_DC_MENU_REPEAT", "BB_MENU_NAV_REPEAT_FIX")) {
+        puts("DC fix: menu key repeat off (BB_DC_MENU_REPEAT=0)");
+        return;
+    }
+    /* push rbp; mov rbp,rsp; push r15; push r14; push r12; push rbx; sub rsp,0x10 */
+    static const unsigned char prologue[15] = {0x55, 0x48, 0x89, 0xe5, 0x41, 0x57, 0x41, 0x56,
+                                               0x41, 0x54, 0x53, 0x48, 0x83, 0xec, 0x10};
+    /* movabs rax,0x700000007; mov [r14+0x40],rax: a new press restarts the countdown at 7 */
+    static const unsigned char reset[14] = {0x48, 0xb8, 0x07, 0, 0, 0, 0x07, 0, 0, 0,
+                                            0x49, 0x89, 0x46, 0x40};
+    /* lea rax,[rip+...]: the frame time's first instruction (microseconds * 1e-6) */
+    static const unsigned char frame_time[7] = {0x48, 0x8d, 0x05, 0x69, 0x7a, 0x89, 0x01};
+    if (size < MENU_REPEAT_TABLE + MENU_REPEAT_ENTRIES * 24 ||
+        memcmp(dc_image + MENU_READER, prologue, sizeof prologue) ||
+        memcmp(dc_image + MENU_REPEAT_RESET, reset, sizeof reset) ||
+        memcmp(dc_image + MENU_FRAME_TIME, frame_time, sizeof frame_time)) {
+        puts("DC fix: menu key repeat: not the 1.28 code, left alone");
+        return;
+    }
+    menu_repeat_buttons = 0;
+    for (unsigned i = 0; i < MENU_REPEAT_ENTRIES; ++i) {
+        const unsigned char *entry = dc_image + MENU_REPEAT_TABLE + i * 24;
+        if (entry[16] && entry[0] < 32) menu_repeat_buttons |= 1u << entry[0];
+    }
+    unsigned char *original = trampoline(dc_image + MENU_READER, sizeof prologue,
+                                         (uintptr_t)(dc_image + MENU_READER + sizeof prologue));
+    if (!original) { puts("DC fix: menu key repeat: no code memory"); return; }
+    menu_reader_original = (MenuReader)(void *)original;
+    write_jump(dc_image + MENU_READER, (uintptr_t)menu_reader);
+    dc_image[MENU_READER + 14] = 0x90;
+    printf("DC fix: menu key repeat at 30 Hz whatever the frame rate (buttons 0x%x)\n",
+           menu_repeat_buttons);
+}
+
+/* --- Resource manager entry without its deadlock (#185) ----------------------------------
+ * Scrolling through cars in the garage could freeze the game (picture stopped, music on):
+ * the resource manager's cleanup waited for the car loader to leave (0x77e876) while the
+ * loader, inside, waited for the cleanup to end (0x77e82a).
+ * The manager (r13 in 0x77e7b0): +0x100 state (0 idle, 1 cleanup pending, 2/3 the same with
+ * a thread inside, 4 cleanup running on the thread at +0x110), +0x104 threads inside,
+ * +0x108 the thread inside, +0x200 the entry lock, +0x208 the lock of +0x110 (both rwlocks,
+ * the entry takes them for reading; the cleanup sets +0x110 under +0x208's write lock). A cleanup
+ * starts with a compare-exchange of the state 1->4 without the entry lock; the entry checks
+ * for one before taking that lock and marks itself inside only after. A cleanup that starts
+ * in between runs with the loader inside.
+ * 0x77e7dc..0x77e8ce is replaced by a call to resource_enter below: the game's entry, plus
+ * one check once the thread has counted itself in under the entry lock: if a cleanup on
+ * another thread started meanwhile, it counts itself out again, waits for it and retries.
+ * It returns with the entry lock held, as 0x77e8ce (which unlocks it) expects (recomp's
+ * version released it as well, so the game's unlock there was a second one).
+ * BB_DC_RESOURCE_ENTRY=0 turns it off.
+ * Idea from driveclub-recomp fc8c6f1 / PR #201 (MoonFuji). */
+enum { RESOURCE_CHECKED = 0x77e7d5, RESOURCE_PATCH = 0x77e7dc, RESOURCE_RESUME = 0x77e8ce,
+       RESOURCE_SELF = 0x7ae780, RESOURCE_LOCK = 0x12402f0, RESOURCE_UNLOCK = 0x12402d0,
+       RESOURCE_SLEEP = 0x664860 };
+typedef int64_t (ABI *ResourceSelf)(void);
+typedef int32_t (ABI *ResourceLock)(void *lock);
+typedef int32_t (ABI *ResourceSleep)(uint32_t microseconds);
+static ResourceSelf resource_self;
+static ResourceLock resource_lock, resource_unlock;
+static ResourceSleep resource_sleep;
+
+static int64_t resource_cleaner(unsigned char *m) {
+    void *mutex = *(void **)(m + 0x208);
+    resource_lock(mutex);
+    const int64_t thread = __atomic_load_n((int64_t *)(m + 0x110), __ATOMIC_ACQUIRE);
+    resource_unlock(mutex);
+    return thread;
+}
+
+static ABI void resource_enter(unsigned char *m) {
+    int32_t *state = (int32_t *)(m + 0x100), *inside = (int32_t *)(m + 0x104);
+    int64_t *owner = (int64_t *)(m + 0x108), *cleaner = (int64_t *)(m + 0x110);
+    void *entry = *(void **)(m + 0x200);
+    const int64_t self = resource_self();
+    for (;;) {
+        /* As the game: wait out a cleanup on another thread. A thread already inside never
+         * waits (the cleanup may be waiting for it to leave). */
+        const int nested = __atomic_load_n(inside, __ATOMIC_ACQUIRE) != 0 &&
+                           __atomic_load_n(owner, __ATOMIC_ACQUIRE) == self;
+        if (!nested && __atomic_load_n(state, __ATOMIC_ACQUIRE) == 4 && resource_cleaner(m) != self)
+            while (__atomic_load_n(state, __ATOMIC_ACQUIRE) == 4) resource_sleep(1);
+        resource_lock(entry);
+        if (__atomic_load_n(inside, __ATOMIC_ACQUIRE) != 0 &&
+            __atomic_load_n(owner, __ATOMIC_ACQUIRE) != self) {
+            do {
+                resource_unlock(entry);
+                resource_sleep(1);
+                resource_lock(entry);
+            } while (__atomic_load_n(owner, __ATOMIC_ACQUIRE) != 0);
+            __atomic_store_n(owner, self, __ATOMIC_RELEASE);
+        }
+        if (__atomic_fetch_add(inside, 1, __ATOMIC_SEQ_CST) != 0) return;
+        int32_t from = 0;
+        __atomic_compare_exchange_n(state, &from, 2, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+        from = 1;
+        __atomic_compare_exchange_n(state, &from, 3, 0, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST);
+        __atomic_store_n(owner, self, __ATOMIC_RELEASE);
+        /* The fix. +0x110 is read without its lock here, so no lock is taken while the
+         * entry lock is held. */
+        if (__atomic_load_n(state, __ATOMIC_SEQ_CST) != 4 ||
+            __atomic_load_n(cleaner, __ATOMIC_ACQUIRE) == self)
+            return;
+        __atomic_fetch_sub(inside, 1, __ATOMIC_SEQ_CST);
+        __atomic_store_n(owner, 0, __ATOMIC_RELEASE);
+        resource_unlock(entry);
+        static unsigned reported;
+        if (reported++ < 8) puts("DC fix: resource entry met a starting cleanup; waits for it");
+    }
+}
+
+static void install_resource_entry(uint64_t size) {
+    if (!fix_enabled("BB_DC_RESOURCE_ENTRY", "BB_RESOURCE_ENTRY_FIX")) {
+        puts("DC fix: resource manager entry off (BB_DC_RESOURCE_ENTRY=0)");
+        return;
+    }
+    /* 0x77e7d5..0x77e8ce: lea rbx,[r13+0x100], then the game's entry up to its store of the
+     * thread inside (249 bytes, checked against the 1.28 eboot) */
+    static const unsigned char expected[] = {
+        0x49,0x8d,0x9d,0x00,0x01,0x00,0x00,0x41,0x8b,0x85,0x00,0x01,0x00,0x00,0x83,0xf8,0x04,0x75,
+        0x49,0xe8,0x93,0xff,0x02,0x00,0x48,0x89,0x5d,0xa8,0x49,0x89,0xc7,0x49,0x8b,0x9d,0x08,0x02,
+        0x00,0x00,0x48,0x89,0xdf,0xe8,0xed,0x1a,0xac,0x00,0x4d,0x8b,0xa5,0x10,0x01,0x00,0x00,0x48,
+        0x89,0xdf,0xe8,0xbe,0x1a,0xac,0x00,0x4d,0x39,0xe7,0x48,0x8b,0x5d,0xa8,0x74,0x16,0x0f,0x1f,
+        0x44,0x00,0x00,0xbf,0x01,0x00,0x00,0x00,0xe8,0x36,0x60,0xee,0xff,0x8b,0x03,0x83,0xf8,0x04,
+        0x74,0xef,0x49,0x8b,0xbd,0x00,0x02,0x00,0x00,0xe8,0xb3,0x1a,0xac,0x00,0x41,0x83,0xbd,0x04,
+        0x01,0x00,0x00,0x00,0x74,0x4c,0xe8,0x34,0xff,0x02,0x00,0x49,0x89,0xc7,0x4d,0x3b,0xbd,0x08,
+        0x01,0x00,0x00,0x74,0x3b,0x0f,0x1f,0x84,0x00,0x00,0x00,0x00,0x00,0x49,0x8b,0xbd,0x00,0x02,
+        0x00,0x00,0xe8,0x64,0x1a,0xac,0x00,0xbf,0x01,0x00,0x00,0x00,0xe8,0xea,0x5f,0xee,0xff,0x49,
+        0x8b,0xbd,0x00,0x02,0x00,0x00,0xe8,0x6e,0x1a,0xac,0x00,0x49,0x83,0xbd,0x08,0x01,0x00,0x00,
+        0x00,0x75,0xd4,0x4d,0x89,0xbd,0x08,0x01,0x00,0x00,0x4d,0x8d,0xa5,0x04,0x01,0x00,0x00,0xb8,
+        0x01,0x00,0x00,0x00,0xf0,0x41,0x0f,0xc1,0x04,0x24,0x85,0xc0,0x75,0x25,0xb9,0x02,0x00,0x00,
+        0x00,0x31,0xc0,0xf0,0x0f,0xb1,0x0b,0xb9,0x03,0x00,0x00,0x00,0xb8,0x01,0x00,0x00,0x00,0xf0,
+        0x0f,0xb1,0x0b,0xe8,0xb9,0xfe,0x02,0x00,0x49,0x89,0x85,0x08,0x01,0x00,0x00};
+    _Static_assert(sizeof expected == RESOURCE_RESUME - RESOURCE_CHECKED, "signature length");
+    if (size < RESOURCE_LOCK + 16 || memcmp(dc_image + RESOURCE_CHECKED, expected, sizeof expected)) {
+        puts("DC fix: resource manager entry: not the 1.28 code, left alone");
+        return;
+    }
+    /* The game's import stubs: scePthreadSelf, pthread_rwlock_rdlock / _unlock, sceKernelUsleep */
+    resource_self = (ResourceSelf)(void *)(dc_image + RESOURCE_SELF);
+    resource_lock = (ResourceLock)(void *)(dc_image + RESOURCE_LOCK);
+    resource_unlock = (ResourceLock)(void *)(dc_image + RESOURCE_UNLOCK);
+    resource_sleep = (ResourceSleep)(void *)(dc_image + RESOURCE_SLEEP);
+    /* mov rdi,r13; movabs rax,resource_enter; call rax; lea r12,[r13+0x104]; jmp 0x77e8ce;
+     * int3 for the rest */
+    unsigned char *c = dc_image + RESOURCE_PATCH;
+    memset(c, 0xcc, RESOURCE_RESUME - RESOURCE_PATCH);
+    static const unsigned char head[] = {0x4c, 0x89, 0xef, 0x48, 0xb8};
+    memcpy(c, head, sizeof head); c += sizeof head;
+    const uintptr_t function = (uintptr_t)resource_enter;
+    memcpy(c, &function, 8); c += 8;
+    static const unsigned char tail[] = {0xff, 0xd0, 0x4d, 0x8d, 0xa5, 0x04, 0x01, 0x00, 0x00, 0xe9};
+    memcpy(c, tail, sizeof tail); c += sizeof tail;
+    const int32_t relative = (int32_t)((dc_image + RESOURCE_RESUME) - (c + 4));
+    memcpy(c, &relative, 4);
+    puts("DC fix: resource manager entry waits out a cleanup that starts as it enters");
+}
+
+void runtime_dc_hooks_install(unsigned char *image, uint64_t size) {
+    dc_image = image;
+    install_menu_repeat(size);
+    install_resource_entry(size);
+    seal_trampolines();
+}

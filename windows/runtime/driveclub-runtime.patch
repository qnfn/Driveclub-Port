+void BufferCache::NoteArena(const Buffer& arena, bool migrated) {
+    const u64 gpu = arena.BufferDeviceAddress();
+    std::printf("Buffer cache: arena %zu, guest %#llx..%#llx at GPU %#llx..%#llx%s\n",
+                arenas.size() - 1, static_cast<unsigned long long>(arena.cpu_addr),
+                static_cast<unsigned long long>(arena.cpu_addr + arena.size_bytes),
+                static_cast<unsigned long long>(gpu),
+                static_cast<unsigned long long>(gpu + arena.size_bytes),
+                migrated ? " (two arenas merged)" : "");
+    Vulkan::Breadcrumbs::NoteRange(
+        gpu, arena.size_bytes,
+        fmt::format("buffer cache arena {} (guest {:#x})", arenas.size() - 1, arena.cpu_addr));
+}
+
+std::string BufferCache::DescribeGpuAddress(u64 gpu_address) const {
+    for (size_t i = 0; i < arenas.size(); ++i) {
+        const Buffer& arena = arenas[i];
+        const u64 base = arena.BufferDeviceAddress();
+        if (gpu_address < base || gpu_address >= base + arena.size_bytes) {
+            continue;
+        }
+        const VAddr guest = arena.cpu_addr + (gpu_address - base);
+        const u64 block = guest >> block_shift;
+        bool resident = false;
+        resident_ranges.ForEachInRange(block, block + 1, [&](const Backing&) { resident = true; });
+        const bool current = address_space[guest >> arena_page_bits] == &arena;
+        bool pending = false;
+        for (const auto& binds : pending_binds) {
+            if (binds.arena != &arena) {
+                continue;
+            }
+            for (const auto& bind : binds.binds) {
+                const u64 offset = guest - arena.cpu_addr;
+                pending |= offset >= bind.resourceOffset && offset < bind.resourceOffset + bind.size;
+            }
+        }
+        return fmt::format("buffer cache: guest address {:#x} in arena {}{}; block {} {}{}", guest,
+                           i, current ? "" : " (replaced by a merged arena)", block,
+                           resident ? "resident" : "NOT resident (no memory bound)",
+                           pending ? ", its bind not submitted yet" : "");
+    }
+    return fmt::format("buffer cache: not in any of its {} arenas", arenas.size());
+}

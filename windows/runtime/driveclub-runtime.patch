+Vulkan::StagingBufferRef BufferCache::ClaimReadbackStaging(u64 size, size_t& index) {
+    index = readback_staging.size();
+    for (size_t i = 0; i < readback_staging.size(); ++i) {
+        const auto& entry = readback_staging[i];
+        if (!entry.held && entry.buffer->SizeBytes() >= size && scheduler.IsFree(entry.tick)) {
+            index = i;
+            break;
+        }
+    }
+    if (index == readback_staging.size()) {
+        // A window's downloads are packed with 64-byte alignment: at most a window plus slack.
+        const u64 alloc_size = std::max<u64>(size, ReadbackWindowSize + 64_KB);
+        readback_staging.push_back({
+            .buffer = std::make_unique<Buffer>(instance, 0, alloc_size, MemoryType::HostCached,
+                                               "Readback staging"),
+        });
+    }
+    auto& entry = readback_staging[index];
+    entry.held = true;
+    return Vulkan::StagingBufferRef{
+        .buffer = entry.buffer.get(),
+        .offset = 0,
+        .size = size,
+        .mapped = entry.buffer->mapped_data.data(),
+        .type = MemoryType::HostCached,
+    };
+}
+
+bool BufferCache::IsReadbackPending(VAddr addr, u64 size) const {
+    return std::ranges::any_of(pending_readbacks, [&](VAddr window) {
+        return window < addr + size && addr < window + ReadbackWindowSize;
+    });
+}
+
+u64 BufferCache::ClaimReadbackWindow(const Buffer* arena, VAddr window, DownloadCopies& copies) {
+    std::scoped_lock lk{readback_mutex};
+    if (IsReadbackPending(window, ReadbackWindowSize)) {
+        return 0;
+    }
+    MergeReadbackReturns();
+    const u64 total_size_bytes = CollectDownloads(arena, window, ReadbackWindowSize, copies);
+    if (total_size_bytes != 0) {
+        pending_readbacks.push_back(window);
+    }
+    return total_size_bytes;
+}
+
+void BufferCache::MergeReadbackReturns() {
+    std::scoped_lock ranges_lk{gpu_ranges_mutex};
+    for (const auto& [addr, size] : readback_returns) {
+        gpu_modified_ranges.Add(addr, size);
+    }
+    readback_returns.clear();
+}

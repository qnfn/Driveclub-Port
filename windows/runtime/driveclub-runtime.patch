-void Rasterizer::ScopedMarkerInsert(const std::string_view& str, bool from_guest) {
-    DrainDrawPipe();
-    if ((from_guest && !EmulatorSettings.IsVkGuestMarkersEnabled()) ||
-        (!from_guest && !EmulatorSettings.IsVkHostMarkersEnabled())) {

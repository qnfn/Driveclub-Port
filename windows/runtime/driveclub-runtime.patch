diff --git a/src/runtime_trophy.c b/src/runtime_trophy.c
new file mode 100644
index 0000000..2501f23
--- /dev/null
+++ b/src/runtime_trophy.c
@@ -0,0 +1,173 @@
+/* DCport: earned trophies, kept across game restarts (#183 in driveclub-recomp: the AMG GT3
+ * needs trophy 126, and the game asks which trophies are earned at every start).
+ *
+ * <user>/trophies/<user id>.txt holds one "id unix-time" line per earned trophy (the format
+ * of <user>/trophies.log, which runtime_services.c keeps appending for the launcher). It is
+ * rewritten whole on each unlock: a temporary file, flushed, then moved over the old one, so
+ * a crash leaves either the old list or the new one. Earlier versions only had trophies.log;
+ * its entries count as the local user's (the only one, id 1).
+ * Idea from driveclub-recomp 78e1e2f / PR #260 (cedarquartz7429). */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include "runtime.h"
+#ifdef _WIN32
+#include <windows.h>
+#include <io.h>
+#else
+#include <unistd.h>
+#endif
+
+enum { TROPHIES = RUNTIME_TROPHY_IDS, USERS = 4, CONTEXTS = 16 };
+typedef struct {
+    int32_t user;     /* 0: free */
+    int loaded;
+    int64_t earned[TROPHIES]; /* unix time it was earned, 0 when not */
+} TrophyUser;
+static TrophyUser users[USERS];
+static struct { int32_t context, user; } contexts[CONTEXTS];
+static pthread_mutex_t trophy_lock = PTHREAD_MUTEX_INITIALIZER;
+
+/* BB_DC_TROPHY_STATE=0: the game is told no trophy is earned and every unlock is accepted,
+ * as in 0.5.4 (the list is still written). */
+static int report_state(void) {
+    const char *value = getenv("BB_DC_TROPHY_STATE");
+    return !(value && *value == '0');
+}
+
+/* Adds "id unix-time" lines; an id already there keeps its earlier time. */
+static void read_list(const char *path, int64_t earned[TROPHIES]) {
+    FILE *f = fopen(path, "r");
+    if (!f) return;
+    char line[128];
+    while (fgets(line, sizeof line, f)) {
+        int id;
+        long long when;
+        char rest;
+        if (sscanf(line, "%d %lld %c", &id, &when, &rest) != 2 || id < 0 || id >= TROPHIES || when <= 0)
+            continue;
+        if (!earned[id] || when < earned[id]) earned[id] = when;
+    }
+    fclose(f);
+}
+
+static void user_path(int32_t user, char *out, size_t size, int temporary) {
+    snprintf(out, size, "%s/trophies/%d.txt%s", runtime_file_user_dir(), (int)user, temporary ? ".new" : "");
+}
+
+static TrophyUser *user_state(int32_t user) {
+    if (user <= 0) user = 1;
+    TrophyUser *slot = NULL;
+    for (int i = 0; i < USERS; ++i) {
+        if (users[i].user == user) { slot = &users[i]; break; }
+        if (!users[i].user && !slot) slot = &users[i];
+    }
+    if (!slot) slot = &users[0]; /* more users than a PS4 has: reuse the first slot */
+    if (slot->user != user || !slot->loaded) {
+        memset(slot, 0, sizeof *slot);
+        slot->user = user;
+        slot->loaded = 1;
+        char path[700];
+        user_path(user, path, sizeof path, 0);
+        read_list(path, slot->earned);
+        if (user == 1) {
+            snprintf(path, sizeof path, "%s/trophies.log", runtime_file_user_dir());
+            read_list(path, slot->earned);
+        }
+    }
+    return slot;
+}
+
+static int save(const TrophyUser *state) {
+    char path[700], temporary[704];
+    snprintf(path, sizeof path, "%s/trophies", runtime_file_user_dir());
+    if (mkdir(path, 0755) && errno != EEXIST) return -1;
+    user_path(state->user, path, sizeof path, 0);
+    user_path(state->user, temporary, sizeof temporary, 1);
+    FILE *f = fopen(temporary, "wb");
+    if (!f) return -1;
+    int ok = 1;
+    for (int id = 0; id < TROPHIES; ++id)
+        if (state->earned[id] && fprintf(f, "%d %lld\n", id, (long long)state->earned[id]) < 0) ok = 0;
+    if (fflush(f)) ok = 0;
+#ifdef _WIN32
+    if (ok && _commit(_fileno(f))) ok = 0;
+#else
+    if (ok && fsync(fileno(f))) ok = 0;
+#endif
+    if (fclose(f)) ok = 0;
+#ifdef _WIN32
+    if (ok && !MoveFileExA(temporary, path, MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) ok = 0;
+#else
+    if (ok && rename(temporary, path)) ok = 0;
+#endif
+    if (!ok) remove(temporary);
+    return ok ? 0 : -1;
+}
+
+void runtime_trophy_context(int32_t context, int32_t user) {
+    pthread_mutex_lock(&trophy_lock);
+    int slot = -1;
+    for (int i = 0; i < CONTEXTS && slot < 0; ++i)
+        if (contexts[i].context == context) slot = i;
+    for (int i = 0; i < CONTEXTS && slot < 0; ++i)
+        if (!contexts[i].context) slot = i;
+    if (slot < 0) slot = (int)((uint32_t)context % CONTEXTS); /* all taken: replace one */
+    contexts[slot].context = context;
+    contexts[slot].user = user;
+    pthread_mutex_unlock(&trophy_lock);
+}
+
+static int32_t context_user(int32_t context) {
+    for (int i = 0; i < CONTEXTS; ++i)
+        if (contexts[i].context && contexts[i].context == context) return contexts[i].user;
+    return 1;
+}
+
+int runtime_trophy_earn(int32_t context, int32_t id, int64_t now) {
+    if (id < 0 || id >= TROPHIES) return -1;
+    pthread_mutex_lock(&trophy_lock);
+    TrophyUser *state = user_state(context_user(context));
+    int result = report_state() ? 1 : 0;
+    if (!state->earned[id]) {
+        state->earned[id] = now > 0 ? now : 1;
+        result = 0;
+        if (save(state)) {
+            char path[700];
+            user_path(state->user, path, sizeof path, 0);
+            fprintf(stderr, "Runtime: trophy %d could not be saved to %s\n", id, path);
+        }
+    }
+    pthread_mutex_unlock(&trophy_lock);
+    return result;
+}
+
+uint32_t runtime_trophy_flags(int32_t context, uint32_t flags[4]) {
+    memset(flags, 0, 16);
+    uint32_t earned = 0;
+    pthread_mutex_lock(&trophy_lock);
+    TrophyUser *state = user_state(context_user(context));
+    for (int id = 0; id < TROPHIES && report_state(); ++id)
+        if (state->earned[id]) { flags[id / 32] |= 1u << (id % 32); ++earned; }
+    pthread_mutex_unlock(&trophy_lock);
+    return earned;
+}
+
+int64_t runtime_trophy_time(int32_t context, int32_t id) {
+    if (id < 0 || id >= TROPHIES) return 0;
+    pthread_mutex_lock(&trophy_lock);
+    const int64_t when = report_state() ? user_state(context_user(context))->earned[id] : 0;
+    pthread_mutex_unlock(&trophy_lock);
+    return when;
+}
+
+void runtime_trophy_reset(void) {
+    pthread_mutex_lock(&trophy_lock);
+    memset(users, 0, sizeof users);
+    memset(contexts, 0, sizeof contexts);
+    pthread_mutex_unlock(&trophy_lock);
+}

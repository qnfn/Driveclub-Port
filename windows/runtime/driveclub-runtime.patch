+        "mute_unfocused", "button_prompts", "motion_blur", "fsr4_auto_exposure", "fsr4_invert_jitter", "model_lod",
+        "output_res", "hud_position", "live_resolution"};
+    std::string kept;
+    FILE* file = std::fopen(Path(), "r");
+    if (!file) return kept;
+    char line[512];
+    while (std::fgets(line, sizeof(line), file)) {
+        const std::string_view text(line);
+        const auto eq = text.find('=');
+        if (text.starts_with('#') || eq == std::string_view::npos) continue;

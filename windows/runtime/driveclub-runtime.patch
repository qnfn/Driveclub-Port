+        return false;
+    }
+    std::scoped_lock lk{queued_store_mutex};
+    queued_stores.push_back({Common::AlignDown(addr, 4), Common::AlignUp(addr + size, 4)});
+    num_queued_stores.fetch_add(1, std::memory_order_release);
+    return true;
